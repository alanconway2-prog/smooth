{% comment %}
  SOAP. / The Smooth Company
  sc-bcorp-duo

  Mobile-first two-up. One stacked column by default; two bordered cards at
  the desktop breakpoint. Each card (a block) takes an optional inline SVG icon,
  heading, body, optional link, and an optional mint sub-block (used for the
  Journey stat: big number + label, or logo + text).

  Reused for: Becoming a B Corp / The Journey, and What's Next / Thank You.
  Headings are <h2> so they inherit the theme serif. Setting ids duo_, block d_.
{% endcomment %}

{%- assign s = section.settings -%}

<style>
  /* Page scoped section gap reset */
  .wlm-content .shopify-section,
  #site-main .shopify-section { margin: 0 !important; padding: 0 !important; }
  wlm.wlm-content { display: contents; }
  #site-main .shopify-section > section { margin: 0 !important; }
  #site-main { gap: 0 !important; row-gap: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
  .wlm-content { gap: 0 !important; }

  #scd-{{ section.id }} {
    background-color: {{ s.duo_bg }};
    color: {{ s.duo_ink }};
    padding: {{ s.duo_pad_m }}px 20px;
  }

  #scd-{{ section.id }} .scd__inner {
    max-width: {{ s.duo_max }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ s.duo_gap_m }}px;
  }

  /* Tailor hides content until its observer fires */
  #scd-{{ section.id }} .scd__inner,
  #scd-{{ section.id }} .scd__inner * {
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    animation: none !important;
    clip-path: none !important;
  }

  #scd-{{ section.id }} .scd__card {
    display: flex;
    flex-direction: column;
  }
  #scd-{{ section.id }} .scd__card--boxed {
    border: 1px solid {{ s.duo_border }};
    padding: {{ s.duo_card_pad_m }}px;
    background: {{ s.duo_box_bg }};
  }
  #scd-{{ section.id }} .scd__card--fill {
    border: 1px solid {{ s.duo_fill_bg }};
    padding: {{ s.duo_card_pad_m }}px;
    background: {{ s.duo_fill_bg }};
    color: {{ s.duo_fill_ink }};
    {% if s.duo_bordered %}
      border: 1px solid {{ s.duo_border }};
      padding: {{ s.duo_card_pad_m }}px;
    {% endif %}
  }

  #scd-{{ section.id }} .scd__icon {
    display: block;
    width: {{ s.duo_icon_size }}px;
    height: {{ s.duo_icon_size }}px;
    margin-bottom: {{ s.duo_gap_icon }}px;
    color: {{ s.duo_icon_color }};
  }

  #scd-{{ section.id }} .scd__icon svg { width: 100%; height: 100%; display: block; }

  #scd-{{ section.id }} .scd__heading {
    margin: 0 0 {{ s.duo_gap_heading }}px;
    padding: 0;
    font-size: 26px;
    line-height: 1.15;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  #scd-{{ section.id }} .scd__body {
    margin: 0;
    padding: 0;
    font-size: {{ s.duo_body_size_m }}px;
    line-height: 1.6;
  }

  #scd-{{ section.id }} .scd__body p { margin: 0 0 1em; }
  #scd-{{ section.id }} .scd__body p:last-child { margin-bottom: 0; }

  #scd-{{ section.id }} .scd__link {
    display: inline-block;
    align-self: flex-start;
    margin-top: {{ s.duo_gap_link }}px;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: {{ s.duo_ink }};
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
    transition: opacity 0.2s ease;
  }
  #scd-{{ section.id }} .scd__link:hover { opacity: 0.6; }

  /* Mint sub-block: full-width band feel on mobile */
  #scd-{{ section.id }} .scd__sub {
    margin-top: {{ s.duo_gap_sub }}px;
    background-color: {{ s.duo_sub_bg }};
    color: {{ s.duo_sub_ink }};
    padding: {{ s.duo_sub_pad_m }}px;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  #scd-{{ section.id }} .scd__sub-logo { flex: 0 0 auto; }
  #scd-{{ section.id }} .scd__sub-logo img,
  #scd-{{ section.id }} .scd__sub-logo svg { display: block; width: {{ s.duo_sub_logo_w }}px; height: auto; color: {{ s.duo_sub_ink }}; }
  #scd-{{ section.id }} .scd__sub-text { flex: 1 1 auto; }

  #scd-{{ section.id }} .scd__sub-text {
    font-size: 14px;
    line-height: 1.5;
  }
  #scd-{{ section.id }} .scd__sub-text p { margin: 0; }

  @media screen and (min-width: 860px) {
    #scd-{{ section.id }} {
      padding: {{ s.duo_pad_d }}px 48px;
    }
    #scd-{{ section.id }} .scd__inner {
      grid-template-columns: 1fr 1fr;
      gap: {{ s.duo_gap_d }}px;
      align-items: {{ s.duo_valign }};
    }
    #scd-{{ section.id }} .scd__card--boxed,
    #scd-{{ section.id }} .scd__card--fill {
      padding: {{ s.duo_card_pad_d }}px;
    }
    #scd-{{ section.id }} .scd__heading {
      font-size: 32px;
    }
    #scd-{{ section.id }} .scd__body {
      font-size: {{ s.duo_body_size_d }}px;
    }
    #scd-{{ section.id }} .scd__sub {
      padding: {{ s.duo_sub_pad_d }}px;
      gap: 28px;
    }
  }
</style>

<section id="scd-{{ section.id }}" class="scd" {{ section.shopify_attributes }}>
  <div class="scd__inner">
    {%- for block in section.blocks -%}
      {%- assign heading = block.settings.d_heading | strip -%}
      {%- assign body = block.settings.d_body -%}
      {%- assign link_text = block.settings.d_link_text | strip -%}
      {%- assign link_url = block.settings.d_link_url -%}
      {%- assign sub_body = block.settings.d_sub_body -%}
      {%- assign sub_logo = block.settings.d_sub_logo -%}
      {%- assign sub_bcorp = block.settings.d_sub_bcorp -%}
      <div class="scd__card{% if block.settings.d_fill %} scd__card--fill{% elsif block.settings.d_boxed %} scd__card--boxed{% endif %}" {{ block.shopify_attributes }}>
        {%- case block.settings.d_icon -%}
          {%- when 'arrow' -%}
            <span class="scd__icon"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="24" cy="24" r="21"/><path d="M18 30 30 18M21 18h9v9"/></svg></span>
          {%- when 'heart' -%}
            <span class="scd__icon"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M24 39C10 30 6 22 9 16c2-4 8-5 11-1l4 4 4-4c3-4 9-3 11 1 3 6-1 14-15 23Z"/></svg></span>
          {%- when 'leaf' -%}
            <span class="scd__icon"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 36C12 20 24 10 38 10c0 16-12 26-26 26ZM12 36c6-8 12-13 20-17"/></svg></span>
          {%- when 'globe' -%}
            <span class="scd__icon"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5 6 5 30 0 36M24 6c-5 6-5 30 0 36M10 14c8 5 20 5 28 0M10 34c8-5 20-5 28 0"/></svg></span>
          {%- endcase -%}

        {%- if heading != blank -%}
          <h2 class="scd__heading">{{ heading }}</h2>
        {%- endif -%}

        {%- if body != blank -%}
          <div class="scd__body rte">{{ body }}</div>
        {%- endif -%}

        {%- if link_text != blank and link_url != blank -%}
          <a class="scd__link" href="{{ link_url }}">{{ link_text }}</a>
        {%- endif -%}

        {%- if sub_body != blank or sub_logo != blank or sub_bcorp -%}
          <div class="scd__sub">
            {%- if sub_logo != blank -%}
              <div class="scd__sub-logo">{{ sub_logo | image_url: width: 240 | image_tag: loading: 'lazy', widths: '80, 160, 240', alt: 'Certified B Corporation' }}</div>
            {%- elsif sub_bcorp -%}
              <div class="scd__sub-logo"><svg viewBox="0 0 60 74" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 24h18c6 0 9 3 9 8s-4 7-9 7H6Z" fill="none"/><circle cx="30" cy="37" r="26"/><text x="30" y="46" text-anchor="middle" font-size="26" fill="currentColor" stroke="none" font-family="Georgia, serif">B</text></svg></div>
            {%- endif -%}
            {%- if sub_body != blank -%}<div class="scd__sub-text rte">{{ sub_body }}</div>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "B Corp: Duo",
  "tag": "section",
  "class": "scd-section",
  "max_blocks": 2,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "duo_bordered",
      "label": "Bordered cards",
      "default": true
    },
    {
      "type": "select",
      "id": "duo_valign",
      "label": "Vertical alignment, desktop",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "stretch", "label": "Equal height" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "stretch"
    },
    {
      "type": "range",
      "id": "duo_icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "duo_gap_d",
      "label": "Gap between cards, desktop",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "duo_gap_m",
      "label": "Gap between cards, mobile",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "duo_card_pad_d",
      "label": "Card padding, desktop",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "duo_card_pad_m",
      "label": "Card padding, mobile",
      "min": 0,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "duo_gap_icon",
      "label": "Gap under icon",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "duo_gap_heading",
      "label": "Gap under heading",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "duo_gap_link",
      "label": "Gap above link",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "duo_gap_sub",
      "label": "Gap above sub-block",
      "min": 12,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "duo_pad_d",
      "label": "Section padding, desktop",
      "min": 40,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "duo_pad_m",
      "label": "Section padding, mobile",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "duo_max",
      "label": "Content max width",
      "min": 800,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1120
    },
    {
      "type": "header",
      "content": "Sub-block (stat or logo panel)"
    },
    {
      "type": "select",
      "id": "duo_sub_cols",
      "label": "Sub-block layout, desktop",
      "options": [
        { "value": "1", "label": "Single column" },
        { "value": "2", "label": "Two columns" }
      ],
      "default": "1"
    },
    {
      "type": "color",
      "id": "duo_sub_bg",
      "label": "Sub-block background",
      "default": "#b5e3d9"
    },
    {
      "type": "color",
      "id": "duo_sub_ink",
      "label": "Sub-block text",
      "default": "#1d1d1b"
    },
    {
      "type": "range",
      "id": "duo_sub_logo_w",
      "label": "Sub-block logo width",
      "min": 32,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "duo_sub_pad_d",
      "label": "Sub-block padding, desktop",
      "min": 12,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "duo_sub_pad_m",
      "label": "Sub-block padding, mobile",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Colour and type"
    },
    {
      "type": "color",
      "id": "duo_bg",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "duo_ink",
      "label": "Text",
      "default": "#1d1d1b"
    },
    {
      "type": "color",
      "id": "duo_border",
      "label": "Card border",
      "default": "#e4e1d9"
    },
    {
      "type": "color",
      "id": "duo_box_bg",
      "label": "Boxed card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "duo_fill_bg",
      "label": "Filled card background",
      "default": "#b5e3d9"
    },
    {
      "type": "color",
      "id": "duo_fill_ink",
      "label": "Filled card text",
      "default": "#1d1d1b"
    },
    {
      "type": "color",
      "id": "duo_icon_color",
      "label": "Icon colour",
      "default": "#2f3d34"
    },
    {
      "type": "range",
      "id": "duo_body_size_d",
      "label": "Body size, desktop",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "duo_body_size_m",
      "label": "Body size, mobile",
      "min": 13,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "d_icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "arrow", "label": "Arrow in circle" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "globe", "label": "Globe" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "d_heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "d_body",
          "label": "Body"
        },
        {
          "type": "text",
          "id": "d_link_text",
          "label": "Link text"
        },
        {
          "type": "url",
          "id": "d_link_url",
          "label": "Link URL"
        },
        {
          "type": "header",
          "content": "Sub-block (logo panel)"
        },
        {
          "type": "richtext",
          "id": "d_sub_body",
          "label": "Sub-block text",
          "default": "<p>We're now part of a network of 10,000+ Certified B Corps globally, and 110 businesses across Ireland, using business as a force for good.</p>"
        },
        {
          "type": "checkbox",
          "id": "d_boxed",
          "label": "Box this card (white)",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "d_fill",
          "label": "Fill this card (mint)",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "d_sub_bcorp",
          "label": "Show built-in B Corp mark",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "d_sub_logo",
          "label": "Or upload a logo",
          "info": "Overrides the built-in mark."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "B Corp: Duo",
      "blocks": [
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
