{% comment %}
  SOAP. / The Smooth Company
  sc-bcorp-thanks

  Closing beat. Centred, ink on white, generous. Heading inherits the theme
  serif (h2). Body, then a single link as the final action.
  Setting ids prefixed tk_.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign heading = s.tk_heading | strip
  assign body = s.tk_body | strip
-%}

<style>
  /* Page scoped section gap reset */
  .wlm-content .shopify-section,
  #site-main .shopify-section { margin: 0 !important; padding: 0 !important; }
  wlm.wlm-content { display: contents; }
  #site-main .shopify-section > section { margin: 0 !important; }
  #site-main { gap: 0 !important; row-gap: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
  .wlm-content { gap: 0 !important; }

  #sctk-{{ section.id }} {
    background-color: {{ s.tk_bg }};
    color: {{ s.tk_ink }};
    padding: {{ s.tk_pad_m }}px 24px;
  }

  #sctk-{{ section.id }} .sctk__inner {
    max-width: {{ s.tk_max }}px;
    margin: 0 auto;
    text-align: center;
  }

  /* Tailor hides content until its observer fires */
  #sctk-{{ section.id }} .sctk__inner,
  #sctk-{{ section.id }} .sctk__inner * {
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    animation: none !important;
    clip-path: none !important;
  }

  /* Heading inherits the theme heading serif. No font-family set. */
  #sctk-{{ section.id }} .sctk__heading {
    margin: 0;
    padding: 0;
    font-size: 24px;
    line-height: 1.15;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  #sctk-{{ section.id }} .sctk__body {
    margin: {{ s.tk_gap_body }}px auto 0;
    padding: 0;
    max-width: 52ch;
    font-size: {{ s.tk_body_size_m }}px;
    line-height: 1.65;
    opacity: 0.9 !important;
  }

  #sctk-{{ section.id }} .sctk__link {
    display: inline-block;
    margin-top: {{ s.tk_gap_link }}px;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: {{ s.tk_ink }};
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
    transition: opacity 0.2s ease;
  }

  #sctk-{{ section.id }} .sctk__link:hover {
    opacity: 0.6;
  }

  @media screen and (min-width: 768px) {
    #sctk-{{ section.id }} {
      padding: {{ s.tk_pad_d }}px 48px;
    }
    #sctk-{{ section.id }} .sctk__heading {
      font-size: 32px;
    }
    #sctk-{{ section.id }} .sctk__body {
      font-size: {{ s.tk_body_size_d }}px;
    }
  }
</style>

<section id="sctk-{{ section.id }}" class="sctk" {{ section.shopify_attributes }}>
  <div class="sctk__inner">
    {%- if heading != blank -%}
      <h2 class="sctk__heading">{{ heading }}</h2>
    {%- endif -%}

    {%- if body != blank -%}
      <p class="sctk__body">{{ body }}</p>
    {%- endif -%}

    {%- if s.tk_link_text != blank and s.tk_link_url != blank -%}
      <a
        class="sctk__link"
        href="{{ s.tk_link_url }}"
        {% if s.tk_link_new_tab %}target="_blank" rel="noopener"{% endif %}
      >
        {{ s.tk_link_text }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "B Corp: Thank you",
  "tag": "section",
  "class": "sctk-section",
  "settings": [
    {
      "type": "text",
      "id": "tk_heading",
      "label": "Heading",
      "default": "Thank you"
    },
    {
      "type": "textarea",
      "id": "tk_body",
      "label": "Body",
      "default": "None of this happens without you. Every product you've picked up, every friend you've recommended us to, you've been part of building a business that does things properly. This certification is as much yours as it is ours."
    },
    {
      "type": "text",
      "id": "tk_link_text",
      "label": "Link text",
      "default": "Learn more about B Corp"
    },
    {
      "type": "url",
      "id": "tk_link_url",
      "label": "Link URL"
    },
    {
      "type": "checkbox",
      "id": "tk_link_new_tab",
      "label": "Open link in a new tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "tk_gap_body",
      "label": "Gap under heading",
      "min": 12,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "tk_gap_link",
      "label": "Gap above link",
      "min": 12,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "tk_pad_d",
      "label": "Section padding, desktop",
      "min": 40,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "tk_pad_m",
      "label": "Section padding, mobile",
      "min": 24,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "tk_max",
      "label": "Content max width",
      "min": 480,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "header",
      "content": "Colour and type"
    },
    {
      "type": "color",
      "id": "tk_bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tk_ink",
      "label": "Text",
      "default": "#1d1d1b"
    },
    {
      "type": "range",
      "id": "tk_body_size_d",
      "label": "Body size, desktop",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "tk_body_size_m",
      "label": "Body size, mobile",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "B Corp: Thank you"
    }
  ]
}
{% endschema %}
