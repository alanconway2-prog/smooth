{% comment %}
  SOAP. / The Smooth Company
  sc-bcorp-statement
  Narrow, centred statement. No headings by default. Keep it short.
{% endcomment %}

{%- liquid
  assign s = section.settings
-%}

<style>
  #sc-bcorp-statement-{{ section.id }} {
    background-color: {{ s.background_color }};
    color: {{ s.text_color }};
    padding-top: {{ s.pad_top_v2 | times: 0.6 | round }}px;
    padding-bottom: {{ s.pad_bot_v2 | times: 0.6 | round }}px;
  }

  #sc-bcorp-statement-{{ section.id }} .sc-bcorp-statement__inner {
    max-width: {{ s.content_width_v2 }}px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: {{ s.text_align }};
  }

  #sc-bcorp-statement-{{ section.id }} .sc-bcorp-statement__eyebrow {
    margin: 0 0 20px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  #sc-bcorp-statement-{{ section.id }} .sc-bcorp-statement__heading {
    margin: 0 0 24px;
    font-size: 24px;
    line-height: 1.15;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  #sc-bcorp-statement-{{ section.id }} .sc-bcorp-statement__body {
    font-size: {{ s.text_size_mobile }}px;
    line-height: 1.65;
  }

  #sc-bcorp-statement-{{ section.id }} .sc-bcorp-statement__body p {
    margin: 0 0 1.1em;
  }

  #sc-bcorp-statement-{{ section.id }} .sc-bcorp-statement__body p:last-child {
    margin-bottom: 0;
  }

  #sc-bcorp-statement-{{ section.id }} .sc-bcorp-statement__rule {
    width: 40px;
    height: 1px;
    background-color: currentColor;
    opacity: 0.25;
    border: 0;
    margin: 0 0 28px;
    {% if s.text_align == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
    {% if s.text_align == 'right' %}margin-left: auto;{% endif %}
  }

  @media screen and (min-width: 768px) {
    #sc-bcorp-statement-{{ section.id }} {
      padding-top: {{ s.pad_top_v2 }}px;
      padding-bottom: {{ s.pad_bot_v2 }}px;
    }
    #sc-bcorp-statement-{{ section.id }} .sc-bcorp-statement__inner {
      padding: 0 48px;
    }
    #sc-bcorp-statement-{{ section.id }} .sc-bcorp-statement__heading {
      font-size: 32px;
    }
    #sc-bcorp-statement-{{ section.id }} .sc-bcorp-statement__body {
      font-size: {{ s.text_size_desktop }}px;
    }
  }
</style>

<section
  id="sc-bcorp-statement-{{ section.id }}"
  class="sc-bcorp-statement"
  {{ section.shopify_attributes }}
>
  <div class="sc-bcorp-statement__inner">
    {%- if s.show_rule -%}
      <hr class="sc-bcorp-statement__rule">
    {%- endif -%}

    {%- if s.eyebrow != blank -%}
      <h2 class="sc-bcorp-statement__heading">{{ s.eyebrow }}</h2>
    {%- endif -%}


    {%- if s.body != blank -%}
      <div class="sc-bcorp-statement__body rte">{{ s.body }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "B Corp: Statement",
  "tag": "section",
  "class": "sc-bcorp-statement-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show short rule above",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our commitment"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A higher standard, independently checked."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>B Corp certification is not a badge you buy. It is a full assessment of how a business treats its people, its suppliers, its customers and the environment, scored and verified by an independent body.</p><p>We chose to be measured because we would rather be held to account than take our own word for it.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_width_v2",
      "label": "Content max width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 960
    },
    {
      "type": "range",
      "id": "pad_top_v2",
      "label": "Padding top, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "pad_bot_v2",
      "label": "Padding bottom, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "header",
      "content": "Colour and type"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1d1d1b"
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Body size, desktop",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Body size, mobile",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "B Corp: Statement"
    }
  ]
}
{% endschema %}
