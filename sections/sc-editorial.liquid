{% comment %}
  Smooth Company — Editorial banner (custom)
  Full-bleed image with a tracked-caps label + button overlaid.
  The label IS the heading here, so no separate heading setting.
{% endcomment %}

{%- assign pos = section.settings.content_position -%}
{%- assign v_align = 'flex-end' -%}
{%- assign h_align = 'flex-start' -%}
{%- assign t_align = 'left' -%}
{%- assign grad_dir = 'to top' -%}
{%- assign grad_center = false -%}
{%- case pos -%}
  {%- when 'bottom-center' -%}
    {%- assign v_align = 'flex-end' -%}{%- assign h_align = 'center' -%}{%- assign t_align = 'center' -%}{%- assign grad_dir = 'to top' -%}
  {%- when 'bottom-right' -%}
    {%- assign v_align = 'flex-end' -%}{%- assign h_align = 'flex-end' -%}{%- assign t_align = 'right' -%}{%- assign grad_dir = 'to top' -%}
  {%- when 'center' -%}
    {%- assign v_align = 'center' -%}{%- assign h_align = 'center' -%}{%- assign t_align = 'center' -%}{%- assign grad_center = true -%}
  {%- when 'top-left' -%}
    {%- assign v_align = 'flex-start' -%}{%- assign h_align = 'flex-start' -%}{%- assign t_align = 'left' -%}{%- assign grad_dir = 'to bottom' -%}
  {%- when 'top-right' -%}
    {%- assign v_align = 'flex-start' -%}{%- assign h_align = 'flex-end' -%}{%- assign t_align = 'right' -%}{%- assign grad_dir = 'to bottom' -%}
  {%- else -%}
    {%- assign v_align = 'flex-end' -%}{%- assign h_align = 'flex-start' -%}{%- assign t_align = 'left' -%}{%- assign grad_dir = 'to top' -%}
{%- endcase -%}
{%- assign ov = section.settings.overlay_opacity | times: 0.01 -%}

{%- if section.settings.enable -%}
<style>
  #shopify-section-{{ section.id }} .sc-editorial {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
    --sc-ov: {{ ov }};
  }
  #shopify-section-{{ section.id }} .sc-editorial__box {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: repeating-linear-gradient(120deg,#e8ded4 0 18px,#f0e8de 18px 36px);
  }
  #shopify-section-{{ section.id }} .sc-editorial__box img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .sc-editorial__overlay {
    position: absolute; inset: 0;
    {%- if grad_center -%}
    background: rgba(12,14,16,var(--sc-ov));
    {%- else -%}
    background: linear-gradient({{ grad_dir }}, rgba(12,14,16,var(--sc-ov)), transparent 55%);
    {%- endif -%}
  }
  #shopify-section-{{ section.id }} .sc-editorial__inner {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    align-items: {{ v_align }};
    justify-content: {{ h_align }};
    padding: 24px;
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .sc-editorial__content {
    display: flex; flex-direction: column;
    text-align: {{ t_align }};
    {%- if t_align == 'center' -%}align-items: center;{%- elsif t_align == 'right' -%}align-items: flex-end;{%- else -%}align-items: flex-start;{%- endif -%}
    max-width: 560px;
  }
  #shopify-section-{{ section.id }} .sc-editorial__label {
    font-family: 'Gotham Medium', sans-serif;
    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
    color: #ffffff; margin: 0 0 18px;
  }
  #shopify-section-{{ section.id }} .sc-editorial__btn {
    display: inline-block;
    font-family: 'Gotham Medium', sans-serif;
    text-transform: uppercase; letter-spacing: 0.14em;
    font-size: 12px; line-height: 1;
    padding: 12px 24px;
    border-radius: 0;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .sc-editorial__btn--outline {
    border: 1px solid #fff; background: transparent; color: #fff;
  }
  #shopify-section-{{ section.id }} .sc-editorial__btn--solid {
    border: 1px solid #fff; background: #fff; color: #1d1d1b;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .sc-editorial { padding-top: {{ section.settings.padding_top_desktop }}px; padding-bottom: {{ section.settings.padding_bottom_desktop }}px; }
    #shopify-section-{{ section.id }} .sc-editorial__box { aspect-ratio: 16 / 7; }
    #shopify-section-{{ section.id }} .sc-editorial__inner { padding: 48px; }
    #shopify-section-{{ section.id }} .sc-editorial__btn { padding: 14px 30px; }
  }
</style>
<div class="sc-editorial">
  <div class="sc-editorial__box">
    {%- if section.settings.image != blank -%}
      {%- assign alt_txt = section.settings.image.alt | default: 'Smooth editorial' -%}
      {{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'lazy', alt: alt_txt, class: 'sc-editorial__img' }}
    {%- endif -%}
    <div class="sc-editorial__overlay"></div>
    <div class="sc-editorial__inner">
      <div class="sc-editorial__content">
        {%- if section.settings.label != blank -%}
          <p class="sc-editorial__label">{{ section.settings.label }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="sc-editorial__btn sc-editorial__btn--{{ section.settings.button_style }}" href="{{ section.settings.button_url | default: '#' }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "SC Editorial banner",
  "tag": "section",
  "class": "sc-section",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Enable section", "default": true },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Banner image" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Overlay darkness", "default": 50 },
    { "type": "header", "content": "Content" },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" },
        { "value": "center", "label": "Center" },
        { "value": "top-left", "label": "Top left" },
        { "value": "top-right", "label": "Top right" }
      ],
      "default": "bottom-left"
    },
    { "type": "text", "id": "label", "label": "Label", "default": "The world of Smooth" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore the range" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "outline", "label": "Outline" },
        { "value": "solid", "label": "Solid" }
      ],
      "default": "outline"
    },
    { "type": "header", "content": "Background & spacing" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 2, "unit": "px", "label": "Top padding (mobile)", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 2, "unit": "px", "label": "Bottom padding (mobile)", "default": 0 },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 240, "step": 2, "unit": "px", "label": "Top padding (desktop)", "default": 110 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 240, "step": 2, "unit": "px", "label": "Bottom padding (desktop)", "default": 0 }
  ],
  "presets": [
    { "name": "SC Editorial banner" }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
