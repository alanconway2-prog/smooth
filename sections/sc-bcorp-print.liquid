{% comment %}
  SOAP. / The Smooth Company
  sc-bcorp-print

  "The smooth print, how we get there." Line icon above each item.
  Desktop: up to 5 columns in a row, hairline dividers between.
  Mobile-first: a horizontal snap-scroll carousel (swipe), each item a fixed
  width card, so five items never crush into a narrow screen.

  Italic serif heading via <h2> (inherits theme serif). Setting ids pr_, block pri_.
{% endcomment %}

{%- assign s = section.settings -%}
{%- assign heading = s.pr_heading | strip -%}
{%- assign count = section.blocks.size -%}

<style>
  /* Page scoped section gap reset */
  .wlm-content .shopify-section,
  #site-main .shopify-section { margin: 0 !important; padding: 0 !important; }
  wlm.wlm-content { display: contents; }
  #site-main .shopify-section > section { margin: 0 !important; }
  #site-main { gap: 0 !important; row-gap: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
  .wlm-content { gap: 0 !important; }

  #scpr-{{ section.id }} {
    background-color: {{ s.pr_bg }};
    color: {{ s.pr_ink }};
    padding: {{ s.pr_pad_m }}px 0;
  }

  #scpr-{{ section.id }} .scpr__head {
    max-width: {{ s.pr_max }}px;
    margin: 0 auto {{ s.pr_gap_heading }}px;
    padding: 0 20px;
    text-align: center;
  }

  /* Tailor hides content until its observer fires */
  #scpr-{{ section.id }} .scpr__head,
  #scpr-{{ section.id }} .scpr__head *,
  #scpr-{{ section.id }} .scpr__track,
  #scpr-{{ section.id }} .scpr__track * {
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    animation: none !important;
    clip-path: none !important;
  }

  #scpr-{{ section.id }} .scpr__heading {
    margin: 0;
    padding: 0;
    font-size: 24px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: -0.01em;
    {% if s.pr_heading_italic %}font-style: italic;{% endif %}
  }

  /* Mobile: horizontal snap carousel */
  #scpr-{{ section.id }} .scpr__track {
    display: flex;
    gap: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 0 20px;
    scrollbar-width: none;
  }
  #scpr-{{ section.id }} .scpr__track::-webkit-scrollbar { display: none; }

  #scpr-{{ section.id }} .scpr__item {
    scroll-snap-align: start;
    flex: 0 0 {{ s.pr_card_w_m }}px;
    max-width: {{ s.pr_card_w_m }}px;
    padding: 4px {{ s.pr_item_pad_m }}px;
    text-align: {{ s.pr_align }};
    position: relative;
  }

  /* divider between items */
  #scpr-{{ section.id }} .scpr__item + .scpr__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: {{ s.pr_divider }};
  }

  #scpr-{{ section.id }} .scpr__icon {
    display: block;
    width: {{ s.pr_icon_size }}px;
    height: {{ s.pr_icon_size }}px;
    margin-bottom: {{ s.pr_gap_icon }}px;
    color: {{ s.pr_icon_color }};
    {% if s.pr_align == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
  }
  #scpr-{{ section.id }} .scpr__icon svg { width: 100%; height: 100%; display: block; }

  #scpr-{{ section.id }} .scpr__title {
    margin: 0 0 {{ s.pr_gap_title }}px;
    font-size: {{ s.pr_title_size }}px;
    line-height: 1.25;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  #scpr-{{ section.id }} .scpr__body {
    margin: 0;
    font-size: {{ s.pr_body_size }}px;
    line-height: 1.55;
    opacity: 0.85 !important;
  }

  /* Desktop: fixed row, equal columns, no scroll */
  @media screen and (min-width: 860px) {
    #scpr-{{ section.id }} {
      padding: {{ s.pr_pad_d }}px 48px;
    }
    #scpr-{{ section.id }} .scpr__head {
      margin-bottom: {{ s.pr_gap_heading_d }}px;
      padding: 0;
    }
    #scpr-{{ section.id }} .scpr__heading { font-size: {{ s.pr_heading_size_d }}px; }
    #scpr-{{ section.id }} .scpr__track {
      max-width: {{ s.pr_max }}px;
      margin: 0 auto;
      overflow: visible;
      padding: 0;
      display: grid;
      grid-template-columns: repeat({{ count }}, 1fr);
    }
    #scpr-{{ section.id }} .scpr__item {
      flex: initial;
      max-width: none;
      padding: 4px {{ s.pr_item_pad_d }}px;
    }
    #scpr-{{ section.id }} .scpr__title { font-size: {{ s.pr_title_size_d }}px; }
    #scpr-{{ section.id }} .scpr__body { font-size: {{ s.pr_body_size_d }}px; }
  }
</style>

<section id="scpr-{{ section.id }}" class="scpr" {{ section.shopify_attributes }}>
  {%- if heading != blank -%}
    <div class="scpr__head">
      <h2 class="scpr__heading">{{ heading }}</h2>
    </div>
  {%- endif -%}

  <div class="scpr__track">
    {%- for block in section.blocks -%}
      {%- assign t = block.settings.pri_title | strip -%}
      {%- assign b = block.settings.pri_body | strip -%}
      <div class="scpr__item" {{ block.shopify_attributes }}>
        {%- case block.settings.pri_icon -%}
          {%- when 'shamrock' -%}
            <span class="scpr__icon"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M23 22c-4-2-9-1-9 4s6 6 9 3M25 22c4-2 9-1 9 4s-6 6-9 3M24 20c-2-4-1-9 4-9s6 6 3 9M24 24c-1 3 0 8 0 8M24 32c-3 0-6 1-7 4M24 32c3 0 6 1 7 4"/></svg></span>
          {%- when 'people' -%}
            <span class="scpr__icon"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="24" cy="15" r="5"/><circle cx="12" cy="18" r="4"/><circle cx="36" cy="18" r="4"/><path d="M15 34c0-5 4-9 9-9s9 4 9 9M4 34c0-4 3-7 7-7M44 34c0-4-3-7-7-7"/></svg></span>
          {%- when 'hair' -%}
            <span class="scpr__icon"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 14c8-4 20-4 28 0M9 22c9-5 21-5 30 0M11 30c8-4 18-4 26 0M14 38c6-3 14-3 20 0"/></svg></span>
          {%- when 'leaf' -%}
            <span class="scpr__icon"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 36C12 20 24 10 38 10c0 16-12 26-26 26ZM12 36c6-8 12-13 20-17"/></svg></span>
          {%- when 'globe' -%}
            <span class="scpr__icon"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5 6 5 30 0 36M24 6c-5 6-5 30 0 36M10 14c8 5 20 5 28 0M10 34c8-5 20-5 28 0"/></svg></span>
        {%- endcase -%}

        {%- if t != blank -%}<p class="scpr__title">{{ t }}</p>{%- endif -%}
        {%- if b != blank -%}<p class="scpr__body">{{ b }}</p>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "B Corp: Print",
  "tag": "section",
  "class": "scpr-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "pr_heading",
      "label": "Heading",
      "default": "The smooth print, how we get there"
    },
    {
      "type": "checkbox",
      "id": "pr_heading_italic",
      "label": "Italic heading",
      "default": true
    },
    {
      "type": "select",
      "id": "pr_align",
      "label": "Item alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Icons and dividers"
    },
    {
      "type": "range",
      "id": "pr_icon_size",
      "label": "Icon size",
      "min": 28,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "color",
      "id": "pr_divider",
      "label": "Divider colour",
      "default": "#e0ddd4"
    },
    {
      "type": "header",
      "content": "Mobile carousel"
    },
    {
      "type": "range",
      "id": "pr_card_w_m",
      "label": "Card width, mobile",
      "min": 200,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 244
    },
    {
      "type": "range",
      "id": "pr_item_pad_m",
      "label": "Item side padding, mobile",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "pr_item_pad_d",
      "label": "Item side padding, desktop",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pr_gap_icon",
      "label": "Gap under icon",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "pr_gap_title",
      "label": "Gap under title",
      "min": 4,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "pr_gap_heading",
      "label": "Gap under heading, mobile",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "pr_gap_heading_d",
      "label": "Gap under heading, desktop",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "pr_pad_d",
      "label": "Section padding, desktop",
      "min": 40,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "pr_pad_m",
      "label": "Section padding, mobile",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "pr_max",
      "label": "Content max width",
      "min": 900,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Colour and type"
    },
    {
      "type": "color",
      "id": "pr_bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "pr_ink",
      "label": "Text",
      "default": "#1d1d1b"
    },
    {
      "type": "color",
      "id": "pr_icon_color",
      "label": "Icon colour",
      "default": "#2f3d34"
    },
    {
      "type": "range",
      "id": "pr_heading_size_d",
      "label": "Heading size, desktop",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "pr_title_size",
      "label": "Item title size, mobile",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "pr_title_size_d",
      "label": "Item title size, desktop",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "pr_body_size",
      "label": "Item body size, mobile",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "pr_body_size_d",
      "label": "Item body size, desktop",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "pri_icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "shamrock", "label": "Shamrock" },
            { "value": "people", "label": "People" },
            { "value": "hair", "label": "Hair" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "globe", "label": "Globe" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "pri_title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "pri_body",
          "label": "Body"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "B Corp: Print",
      "blocks": [
        { "type": "item", "settings": { "pri_icon": "shamrock", "pri_title": "Thoughtfully made", "pri_body": "Made right here in Ireland, working hand in hand with our chemists, so we're always close to the science, and closer to you." } },
        { "type": "item", "settings": { "pri_icon": "people", "pri_title": "Built by women", "pri_body": "An all-female team behind every formula, every decision, every Smooth step." } },
        { "type": "item", "settings": { "pri_icon": "hair", "pri_title": "Smooth for everyone", "pri_body": "Every hair type, every texture, every experience level. If it doesn't work for everyone, it doesn't make the cut." } },
        { "type": "item", "settings": { "pri_icon": "leaf", "pri_title": "Packaging we stand behind", "pri_body": "100% FSC-certified, renewable wherever we can, and zero single-use plastic. No exceptions." } },
        { "type": "item", "settings": { "pri_icon": "globe", "pri_title": "Glossy waves", "pri_body": "We're making glossy waves, for you, and for everyone our products touch." } }
      ]
    }
  ]
}
{% endschema %}
