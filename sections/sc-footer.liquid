{% comment %}
  Smooth Company — Footer (custom, ink treatment)
  Ink background. Desktop = open columns (brand + newsletter top grid, then a
  4-up menu grid). Mobile = centered brand + newsletter, menus as accordions
  (rotating chevron, ALL CLOSED by default), centered social icons, policies row.
  Used inside the footer section group. Keeps the {% form 'customer' %} newsletter
  and the mobile accordion toggle JS.
{% endcomment %}

{%- liquid
  assign logo = section.settings.logo
  assign form_id = 'sc-footer-newsletter-' | append: section.id
  assign shop_name = shop.name | escape
  assign copy = section.settings.copyright | replace: '{{ shop.name }}', shop.name

  assign ig = settings.social_instagram_link
  assign tt = settings.social_tiktok_link
  assign yt = settings.social_youtube_link
  assign fb = settings.social_facebook_link
  assign has_social = false
  if ig != blank or tt != blank or yt != blank or fb != blank
    assign has_social = true
  endif

  assign menu_blocks = section.blocks | where: 'type', 'menu'
  assign policy_blocks = section.blocks | where: 'type', 'policy'
-%}

{%- if section.settings.enable -%}
<style>
  #shopify-section-{{ section.id }} .sc-foot {
    background: {{ section.settings.background_color }}; color: {{ section.settings.text_color }}; --sc-line: #333330;
  }

  /* --- Brand + newsletter (top) --- */
  #shopify-section-{{ section.id }} .sc-foot__top { text-align: center; padding: 48px 24px 8px; }
  #shopify-section-{{ section.id }} .sc-foot__logo { height: 26px; width: auto; display: block; margin: 0 auto 14px; }
  #shopify-section-{{ section.id }} .sc-foot__brandline {
    font-family: 'Gotham Medium', sans-serif; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
    color: #6A6A63; margin: 0 0 28px;
  }
  #shopify-section-{{ section.id }} .sc-foot__intro {
    font-family: 'Gotham Medium', sans-serif; font-size: 14px; color: #fff; line-height: 1.5;
    margin: 0 auto 16px; max-width: 280px;
  }
  #shopify-section-{{ section.id }} .sc-foot__form { display: flex; gap: 8px; max-width: 320px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .sc-foot__input {
    flex: 1 1 auto; min-width: 0; border: 1px solid #3a3a36; background: transparent; padding: 13px 14px;
    font-family: 'Gotham Medium', sans-serif; font-size: 13px; color: #fff;
  }
  #shopify-section-{{ section.id }} .sc-foot__input::placeholder { color: #8f8f88; }
  #shopify-section-{{ section.id }} .sc-foot__submit {
    flex: 0 0 auto; background: #fff; color: #1d1d1b; border: none; border-radius: 0; padding: 0 22px;
    font-family: 'Gotham Medium', sans-serif; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; cursor: pointer;
  }
  #shopify-section-{{ section.id }} .sc-foot__success {
    color: #fff; font-family: 'Gotham Medium', sans-serif; font-size: 13px; margin: 0;
  }

  /* --- Menu columns (accordion on mobile) --- */
  #shopify-section-{{ section.id }} .sc-foot__cols { border-top: 1px solid var(--sc-line); margin-top: 24px; }
  #shopify-section-{{ section.id }} .sc-foot__col { border-bottom: 1px solid var(--sc-line); text-align: left; }
  #shopify-section-{{ section.id }} .sc-foot__toggle {
    width: 100%; display: flex; align-items: center; justify-content: space-between;
    background: none; border: none; padding: 18px 24px; font-family: 'Gotham Medium', sans-serif; cursor: pointer; color: #fff;
  }
  #shopify-section-{{ section.id }} .sc-foot__toggle span { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; }
  #shopify-section-{{ section.id }} .sc-foot__chev { transition: transform .2s; flex: 0 0 auto; }
  #shopify-section-{{ section.id }} .sc-foot__toggle[aria-expanded="true"] .sc-foot__chev { transform: rotate(180deg); }
  #shopify-section-{{ section.id }} .sc-foot__panel { display: none; padding: 0 24px 18px; }
  #shopify-section-{{ section.id }} .sc-foot__toggle[aria-expanded="true"] + .sc-foot__panel { display: block; }
  #shopify-section-{{ section.id }} .sc-foot__panel a {
    display: block; font-family: 'Gotham Medium', sans-serif; font-size: 13px; line-height: 2.1; color: {{ section.settings.text_color }};
  }

  /* --- Social + policies --- */
  #shopify-section-{{ section.id }} .sc-foot__social {
    display: flex; justify-content: center; align-items: center; gap: 22px;
    padding: 30px 0 22px; border-top: 1px solid var(--sc-line);
  }
  #shopify-section-{{ section.id }} .sc-foot__social a { color: {{ section.settings.text_color }}; display: inline-flex; }
  #shopify-section-{{ section.id }} .sc-foot__social a:hover { color: #fff; }
  #shopify-section-{{ section.id }} .sc-foot__social svg { width: 20px; height: 20px; display: block; }
  #shopify-section-{{ section.id }} .sc-foot__policies { text-align: center; padding: 0 24px 40px; }
  #shopify-section-{{ section.id }} .sc-foot__pol {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 14px; margin-bottom: 12px;
  }
  #shopify-section-{{ section.id }} .sc-foot__pol a,
  #shopify-section-{{ section.id }} .sc-foot__copy {
    font-family: 'Gotham Medium', sans-serif; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: #6A6A63;
  }
  #shopify-section-{{ section.id }} .sc-foot__pol a:hover { color: #fff; }

  /* --- Desktop --- */
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .sc-foot__top {
      display: grid; grid-template-columns: 1.4fr 1fr; gap: 64px; align-items: center;
      padding: 72px 48px 48px; border-bottom: 1px solid var(--sc-line); text-align: left;
    }
    #shopify-section-{{ section.id }} .sc-foot__logo { height: 30px; margin: 0 0 14px; }
    #shopify-section-{{ section.id }} .sc-foot__brandline { margin: 0; }
    #shopify-section-{{ section.id }} .sc-foot__intro { margin: 0 0 16px; max-width: none; }
    #shopify-section-{{ section.id }} .sc-foot__form { max-width: none; margin: 0; }
    #shopify-section-{{ section.id }} .sc-foot__submit { padding: 0 28px; }

    #shopify-section-{{ section.id }} .sc-foot__cols {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; padding: 40px 48px; border-top: none; margin-top: 0;
    }
    #shopify-section-{{ section.id }} .sc-foot__col { border-bottom: none; }
    #shopify-section-{{ section.id }} .sc-foot__toggle { padding: 0 0 14px; cursor: default; pointer-events: none; }
    #shopify-section-{{ section.id }} .sc-foot__chev { display: none; }
    #shopify-section-{{ section.id }} .sc-foot__panel { display: block !important; padding: 0; }
  }
</style>

<div class="sc-foot">
  <div class="sc-foot__top">
    <div class="sc-foot__brand">
      {%- if logo != blank -%}
        <img class="sc-foot__logo" src="{{ logo | image_url: width: 400 }}" alt="{{ shop_name }}" width="200" height="35">
      {%- else -%}
        <img class="sc-foot__logo" src="{{ 'sc-logo-white.png' | asset_url }}" alt="{{ shop_name }}" width="200" height="35">
      {%- endif -%}
      {%- if section.settings.brand_line != blank -%}
        <div class="sc-foot__brandline">{{ section.settings.brand_line }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_newsletter -%}
      <div class="sc-foot__news">
        {%- if section.settings.newsletter_text != blank -%}
          <p class="sc-foot__intro">{{ section.settings.newsletter_text }}</p>
        {%- endif -%}
        {% form 'customer', id: form_id, class: 'sc-foot__form' %}
          {%- if form.posted_successfully? -%}
            <p class="sc-foot__success">Thanks — you’re on the list.</p>
          {%- else -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input class="sc-foot__input" type="email" name="contact[email]" placeholder="Email address" autocomplete="email" required>
            <button class="sc-foot__submit" type="submit" name="commit">{{ section.settings.newsletter_button | default: 'Subscribe' }}</button>
          {%- endif -%}
        {% endform %}
      </div>
    {%- endif -%}
  </div>

  <nav class="sc-foot__cols" aria-label="Footer">
    {%- for block in menu_blocks -%}
      <div class="sc-foot__col" {{ block.shopify_attributes }}>
        <button class="sc-foot__toggle" type="button" aria-expanded="false">
          <span>{{ block.settings.heading }}</span>
          <svg class="sc-foot__chev" width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.3"/></svg>
        </button>
        <div class="sc-foot__panel">
          {%- if block.settings.menu != blank -%}
            {%- for link in linklists[block.settings.menu].links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </nav>

  <div class="sc-foot__social">
    {%- if has_social -%}
      {%- if ig != blank -%}<a href="{{ ig }}" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="7" r="1.2" fill="currentColor"/></svg></a>{%- endif -%}
      {%- if tt != blank -%}<a href="{{ tt }}" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 3c.3 2 1.6 3.4 3.6 3.6v2.5c-1.3 0-2.5-.4-3.6-1.1v5.6c0 3-2.4 5.4-5.4 5.4S5.2 19.6 5.2 16.6 7.6 11.2 10.6 11.2c.3 0 .6 0 .9.1v2.6a2.9 2.9 0 1 0 2 2.7V3H16z"/></svg></a>{%- endif -%}
      {%- if yt != blank -%}<a href="{{ yt }}" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2.5" y="6" width="19" height="12" rx="3.5" stroke="currentColor" stroke-width="1.6"/><path d="M10 9.5l5 2.5-5 2.5z" fill="currentColor"/></svg></a>{%- endif -%}
    {%- else -%}
      <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="7" r="1.2" fill="currentColor"/></svg></a>
      <a href="#" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 3c.3 2 1.6 3.4 3.6 3.6v2.5c-1.3 0-2.5-.4-3.6-1.1v5.6c0 3-2.4 5.4-5.4 5.4S5.2 19.6 5.2 16.6 7.6 11.2 10.6 11.2c.3 0 .6 0 .9.1v2.6a2.9 2.9 0 1 0 2 2.7V3H16z"/></svg></a>
      <a href="#" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2.5" y="6" width="19" height="12" rx="3.5" stroke="currentColor" stroke-width="1.6"/><path d="M10 9.5l5 2.5-5 2.5z" fill="currentColor"/></svg></a>
    {%- endif -%}
  </div>

  <div class="sc-foot__policies">
    {%- if policy_blocks.size > 0 -%}
      <div class="sc-foot__pol">
        {%- for block in policy_blocks -%}
          <a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
    <div class="sc-foot__copy">{{ copy }}</div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root || root.dataset.scFootInit) return;
    root.dataset.scFootInit = '1';
    root.querySelectorAll('.sc-foot__toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (window.matchMedia('(min-width: 1024px)').matches) return;
        btn.setAttribute('aria-expanded', btn.getAttribute('aria-expanded') === 'true' ? 'false' : 'true');
      });
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "SC Footer",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Enable section", "default": true },
    { "type": "image_picker", "id": "logo", "label": "Wordmark (white)", "info": "Defaults to the bundled white wordmark if left empty." },
    { "type": "text", "id": "brand_line", "label": "Brand line", "default": "A certified B Corp · 1% to charity" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter intro", "default": "Join for early drops & 10% off." },
    { "type": "text", "id": "newsletter_button", "label": "Button label", "default": "Subscribe" },
    { "type": "header", "content": "Bottom" },
    { "type": "text", "id": "copyright", "label": "Copyright line", "default": "© {{ shop.name }} · A certified B Corp" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1d1d1b" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#B9B9B2" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "policy",
      "name": "Policy link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Terms" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SC Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Learn" } },
        { "type": "menu", "settings": { "heading": "Help" } },
        { "type": "menu", "settings": { "heading": "Follow" } },
        { "type": "policy", "settings": { "label": "Terms" } },
        { "type": "policy", "settings": { "label": "Privacy" } },
        { "type": "policy", "settings": { "label": "Accessibility" } }
      ]
    }
  ]
}
{% endschema %}
