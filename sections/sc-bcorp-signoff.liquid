<style>
  .wlm-content .shopify-section,
  #site-main .shopify-section { margin: 0 !important; padding: 0 !important; }
  wlm.wlm-content { display: contents; }
  #site-main .shopify-section > section { margin: 0 !important; }
  #site-main { gap: 0 !important; row-gap: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
  .wlm-content { gap: 0 !important; }

  #scso-{{ section.id }} {
    background-color: {{ section.settings.so_bg }};
    color: {{ section.settings.so_ink }};
    padding: {{ section.settings.so_pad_m }}px 16px;
  }

  #scso-{{ section.id }} .scso__inner {
    max-width: {{ section.settings.so_max }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
    align-items: center;
  }

  #scso-{{ section.id }} .scso__inner,
  #scso-{{ section.id }} .scso__inner * {
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    animation: none !important;
    clip-path: none !important;
  }

  #scso-{{ section.id }} .scso__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    padding: 8px 6px;
    position: relative;
  }

  #scso-{{ section.id }} .scso__item + .scso__item::before {
    content: '';
    position: absolute;
    left: 0; top: 10%; bottom: 10%;
    width: 1px;
    background: {{ section.settings.so_divider }};
  }

  #scso-{{ section.id }} .scso__icon {
    width: {{ section.settings.so_icon_size_m }}px;
    height: {{ section.settings.so_icon_size_m }}px;
    color: {{ section.settings.so_ink }};
  }
  #scso-{{ section.id }} .scso__icon svg { width: 100%; height: 100%; display: block; }

  #scso-{{ section.id }} .scso__label {
    margin: 0;
    font-size: {{ section.settings.so_size_m }}px;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media screen and (min-width: 768px) {
    #scso-{{ section.id }} { padding: {{ section.settings.so_pad_d }}px 48px; }
    #scso-{{ section.id }} .scso__item { flex-direction: row; gap: 16px; padding: 8px 24px; }
    #scso-{{ section.id }} .scso__icon { width: {{ section.settings.so_icon_size_d }}px; height: {{ section.settings.so_icon_size_d }}px; }
    #scso-{{ section.id }} .scso__label { font-size: {{ section.settings.so_size_d }}px; text-align: left; }
  }
</style>

<section id="scso-{{ section.id }}" class="scso" {{ section.shopify_attributes }}>
  <div class="scso__inner">
    {%- for block in section.blocks -%}
      {%- assign l = block.settings.soi_label | strip -%}
      <div class="scso__item" {{ block.shopify_attributes }}>
        {%- case block.settings.soi_icon -%}
          {%- when 'smooth' -%}
            <span class="scso__icon"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M30 14c-2-3-6-4-9-2s-4 6-1 8l6 4c3 2 2 7-2 8s-8-1-9-4"/></svg></span>
          {%- when 'globe' -%}
            <span class="scso__icon"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5 6 5 30 0 36M24 6c-5 6-5 30 0 36M10 14c8 5 20 5 28 0M10 34c8-5 20-5 28 0"/></svg></span>
          {%- when 'heart' -%}
            <span class="scso__icon"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M24 39C10 30 6 22 9 16c2-4 8-5 11-1l4 4 4-4c3-4 9-3 11 1 3 6-1 14-15 23Z"/></svg></span>
        {%- endcase -%}
        {%- if l != blank -%}<p class="scso__label">{{ l }}</p>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "B Corp: Signoff",
  "tag": "section",
  "class": "scso-section",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "so_icon_size_d", "label": "Icon size, desktop", "min": 20, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "so_icon_size_m", "label": "Icon size, mobile", "min": 18, "max": 40, "step": 2, "unit": "px", "default": 26 },
    { "type": "range", "id": "so_pad_d", "label": "Padding, desktop", "min": 16, "max": 96, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "so_pad_m", "label": "Padding, mobile", "min": 16, "max": 72, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "so_max", "label": "Content max width", "min": 600, "max": 1200, "step": 20, "unit": "px", "default": 960 },
    { "type": "header", "content": "Colour and type" },
    { "type": "color", "id": "so_bg", "label": "Background", "default": "#b5e3d9" },
    { "type": "color", "id": "so_ink", "label": "Text", "default": "#1d1d1b" },
    { "type": "color", "id": "so_divider", "label": "Divider colour", "default": "#8fccbc" },
    { "type": "range", "id": "so_size_d", "label": "Label size, desktop", "min": 11, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "so_size_m", "label": "Label size, mobile", "min": 10, "max": 15, "step": 1, "unit": "px", "default": 11 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "soi_icon", "label": "Icon", "options": [ { "value": "none", "label": "None" }, { "value": "smooth", "label": "Smooth S" }, { "value": "globe", "label": "Globe" }, { "value": "heart", "label": "Heart" } ], "default": "none" },
        { "type": "text", "id": "soi_label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "B Corp: Signoff",
      "blocks": [
        { "type": "item", "settings": { "soi_icon": "smooth", "soi_label": "Certified smoothest operator" } },
        { "type": "item", "settings": { "soi_icon": "globe", "soi_label": "Beauty with purpose" } },
        { "type": "item", "settings": { "soi_icon": "heart", "soi_label": "The Smooth Way" } }
      ]
    }
  ]
}
{% endschema %}
