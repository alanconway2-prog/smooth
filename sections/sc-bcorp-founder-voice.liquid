{%- assign s = section.settings -%}
{%- assign quote = s.fv_quote | strip -%}
{%- assign qname = s.fv_name | strip -%}
{%- assign qrole = s.fv_role | strip -%}
{%- assign alt_photo = s.fv_image.alt | default: qname | default: 'Founder portrait' -%}
{%- assign img_order = 1 -%}
{%- if s.fv_position == 'right' -%}{%- assign img_order = 2 -%}{%- endif -%}

<style>
  .wlm-content .shopify-section,
  #site-main .shopify-section { margin: 0 !important; padding: 0 !important; }
  wlm.wlm-content { display: contents; }
  #site-main .shopify-section > section { margin: 0 !important; }
  #site-main { gap: 0 !important; row-gap: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
  .wlm-content { gap: 0 !important; }

  #scfv-{{ section.id }} {
    background-color: {{ s.fv_bg }};
    color: {{ s.fv_ink }};
    padding: {{ s.fv_pad_m }}px 24px;
  }
  #scfv-{{ section.id }} .scfv__inner {
    max-width: {{ s.fv_max }}px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: {{ s.fv_gap_m }}px; align-items: center;
  }
  #scfv-{{ section.id }} .scfv__inner,
  #scfv-{{ section.id }} .scfv__inner * {
    opacity: 1 !important; visibility: visible !important; transform: none !important; animation: none !important; clip-path: none !important;
  }
  #scfv-{{ section.id }} .scfv__media {
    width: 100%; aspect-ratio: {{ s.fv_ratio_m }}; overflow: hidden; background-color: {{ s.fv_placeholder }};
  }
  #scfv-{{ section.id }} .scfv__media img,
  #scfv-{{ section.id }} .scfv__media svg { width: 100%; height: 100%; object-fit: cover; object-position: {{ s.fv_focal }}; display: block; }

  #scfv-{{ section.id }} .scfv__quote {
    margin: 0; padding: 0; font-size: {{ s.fv_quote_size_m }}px; line-height: 1.5; font-weight: 400; font-style: italic;
  }
  #scfv-{{ section.id }} .scfv__attr {
    margin-top: 24px; padding-top: 16px; border-top: 1px solid currentColor; display: flex; flex-direction: column; gap: 4px;
  }
  #scfv-{{ section.id }} .scfv__name { font-size: 13px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; }
  #scfv-{{ section.id }} .scfv__role { font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.6; }

  @media screen and (min-width: 860px) {
    #scfv-{{ section.id }} { padding: {{ s.fv_pad_d }}px 48px; }
    #scfv-{{ section.id }} .scfv__inner {
      grid-template-columns: {{ s.fv_media_w }}fr {{ 100 | minus: s.fv_media_w }}fr;
      gap: {{ s.fv_gap_d }}px; align-items: center;
    }
    #scfv-{{ section.id }} .scfv__media { aspect-ratio: {{ s.fv_ratio_d }}; order: {{ img_order }}; }
    #scfv-{{ section.id }} .scfv__quote { font-size: {{ s.fv_quote_size_d }}px; }
  }
</style>

<section id="scfv-{{ section.id }}" class="scfv" {{ section.shopify_attributes }}>
  <div class="scfv__inner">
    <div class="scfv__media">
      {%- if s.fv_image != blank -%}
        {{ s.fv_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 860px) 45vw, 100vw', widths: '480, 768, 1000, 1200', alt: alt_photo }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="scfv__content">
      {%- if quote != blank -%}<p class="scfv__quote">{{ quote }}</p>{%- endif -%}
      {%- if qname != blank -%}
        <div class="scfv__attr">
          <span class="scfv__name">{{ qname }}</span>
          {%- if qrole != blank -%}<span class="scfv__role">{{ qrole }}</span>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "B Corp: Founder voice",
  "tag": "section",
  "class": "scfv-section",
  "settings": [
    { "type": "textarea", "id": "fv_quote", "label": "Quote", "default": "The Smooth Company was never just about creating products people love. It was about building a business that could make a positive impact. It reflects our ethos of thoughtful decisions, continuous improvement and a genuine commitment to doing business differently." },
    { "type": "text", "id": "fv_name", "label": "Name", "default": "Áine Kennedy" },
    { "type": "text", "id": "fv_role", "label": "Role", "default": "Founder and CEO" },
    { "type": "header", "content": "Photo" },
    { "type": "image_picker", "id": "fv_image", "label": "Photo" },
    { "type": "select", "id": "fv_position", "label": "Photo position, desktop", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "select", "id": "fv_focal", "label": "Focal point", "options": [ { "value": "left center", "label": "Left" }, { "value": "center center", "label": "Centre" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" } ], "default": "center center" },
    { "type": "select", "id": "fv_ratio_d", "label": "Photo ratio, desktop", "options": [ { "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait 4:5" }, { "value": "4 / 3", "label": "Landscape 4:3" } ], "default": "4 / 5" },
    { "type": "select", "id": "fv_ratio_m", "label": "Photo ratio, mobile", "options": [ { "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait 4:5" }, { "value": "4 / 3", "label": "Landscape 4:3" } ], "default": "4 / 3" },
    { "type": "color", "id": "fv_placeholder", "label": "Placeholder colour", "default": "#9ed3c4" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "fv_media_w", "label": "Photo column width, desktop", "min": 35, "max": 55, "step": 5, "unit": "%", "default": 45 },
    { "type": "range", "id": "fv_gap_d", "label": "Gap, desktop", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "fv_gap_m", "label": "Gap, mobile", "min": 16, "max": 72, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "fv_pad_d", "label": "Section padding, desktop", "min": 40, "max": 200, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "fv_pad_m", "label": "Section padding, mobile", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "fv_max", "label": "Content max width", "min": 800, "max": 1400, "step": 20, "unit": "px", "default": 1120 },
    { "type": "header", "content": "Colour and type" },
    { "type": "color", "id": "fv_bg", "label": "Background", "default": "#eef4f2" },
    { "type": "color", "id": "fv_ink", "label": "Text", "default": "#1d1d1b" },
    { "type": "range", "id": "fv_quote_size_d", "label": "Quote size, desktop", "min": 15, "max": 26, "step": 1, "unit": "px", "default": 19 },
    { "type": "range", "id": "fv_quote_size_m", "label": "Quote size, mobile", "min": 14, "max": 22, "step": 1, "unit": "px", "default": 16 }
  ],
  "presets": [ { "name": "B Corp: Founder voice" } ]
}
{% endschema %}
