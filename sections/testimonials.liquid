{% liquid
  assign background_color = section.settings.background_color
  assign color_text = section.settings.color_text
%}

<section data-component="testimonials" data-component-type="section" {% if tag != blank %}data-component-tag="{{ tag }}" {% endif %}class="testimonials">
  <script
    type="application/json"
    data-component-data
  >
    {
      "autoPlay": {{ section.settings.autoplay }},
      "autoPlayDuration": {{ section.settings.autoplay_duration | times: 1000 }},
      "animateOutDuration": 175,
      "animateInDelay": 100
    }
  </script>

  <section-wrapper
    class="testimonials__wrapper"
    {% if section.settings.wide %}
      width="wide"
    {% endif %}
  >
    <section-content
      class="
        testimonials__content
        testimonials__content--{{ section.settings.content_display }}
        testimonials__content--{{ section.settings.quote_size }}
      "
      style="
        {% if background_color.alpha != 0.0 and background_color != blank %}
        --local-background-color: {{ background_color }};
        {% endif %}
        {% if color_text.alpha != 0.0 and color_text != blank %}
        --local-text-color: {{ color_text }};
        {% endif %}
        {% if section.settings.desktop_image_height != 'natural' %}
        --block-image-height-desktop: {{ section.settings.desktop_image_height }}px;
        {% endif %}
        {% if section.settings.mobile_image_height != 'natural' %}
        --block-image-height-mobile: {{ section.settings.mobile_image_height }}px;
        {% endif %}
      "
    >
      <div class="testimonials__slider" data-testimonials-slider>
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'quote' %}
              {% comment %}Component block-quote:default begin{% endcomment %}
              {% liquid 
                assign desktop_image = block.settings.desktop_image
                assign mobile_image = block.settings.mobile_image
                assign image_link = block.settings.image_link
                assign star_rating = block.settings.star_rating
                assign author_details = block.settings.author_details
              %}
              
              <div
                data-component="block-quote"
                data-component-type="block"
                {% if tag != blank %}data-component-tag="{{ tag }}"
                {% endif %}class="
                  block-quote
                  block-quote--justify-{{ block.settings.text_alignment }}
                "
                {{ block.shopify_attributes }}
              >
                <div
                  class="
                    block-quote__container
                    block-quote__container--{{ block.settings.desktop_image_position }}
                  "
                >
                  {% if desktop_image or mobile_image %}
                    <div
                      class="block-quote__image"
                      style="--local-desktop-image-width: {{ block.settings.desktop_image_width }}%;"
                    >
                      {% if image_link != blank %}
                      <a class="block-quote__image-link" href="{{ image_link }}">
                      {% endif %}
                        {% if desktop_image %}
                          <div class="block-quote__image-desktop">
                            {% comment %}Component lazy-img:default begin{% endcomment %}
                            {% render 'lazy-img', img: block.settings.desktop_image, size: '1200x', lazy: true, canvas: true, focal_point: block.settings.desktop_image.presentation.focal_point, attr: 'draggable="false"' %}
                            {% comment %}Component lazy-img:default end{% endcomment %}
                          </div>
                        {% endif %}
                        {% if mobile_image %}
                          <div class="block-quote__image-mobile">
                            {% comment %}Component lazy-img:default begin{% endcomment %}
                            {% render 'lazy-img', img: block.settings.mobile_image, size: '768x', lazy: true, canvas: true, focal_point: block.settings.mobile_image.presentation.focal_point, attr: 'draggable="false"' %}
                            {% comment %}Component lazy-img:default end{% endcomment %}
                          </div>
                        {% endif %}
                      {% if image_link != blank %}
                      </a>
                      {% endif %}
                    </div>
                  {% endif %}
              
                  <div class="block-quote__text">
                    {% if star_rating != '0' %}
                      <div
                        class="block-quote__star-rating"
                        role="img"
                        aria-label="{{ star_rating }}/5 stars"
                      >
                        {% for i in (1..5) %}
                          <span class="block-quote__star">{% comment %}Icon star:default begin{% endcomment %}
<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 16" width="24" height="24"><path fill="currentColor" d="M7.688 1.047a.333.333 0 0 1 .624 0l1.687 4.784h4.766a.334.334 0 0 1 .216.587L11 9.72l1.667 5.007a.333.333 0 0 1-.513.374L8 12.054 3.844 15.1a.333.333 0 0 1-.511-.374L4.999 9.72l-3.982-3.3a.333.333 0 0 1 .216-.588H6l1.689-4.784Z"/></svg>
{% comment %}Icon star:default end{% endcomment %}</span>
              
                          {% if i == 3 and star_rating == '3.5' %}
                            <span class="block-quote__star">{% comment %}Icon star-half:default begin{% endcomment %}
<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M11.532 1.575A.5.5 0 0 1 12 1.25v16.837l-6.232 4.569A.499.499 0 0 1 5 22.095l2.499-7.51-5.972-4.95a.5.5 0 0 1 .324-.882H9l2.533-7.177-.002-.001Z"/></svg>
{% comment %}Icon star-half:default end{% endcomment %}</span>
                            {% break %}
                          {% elsif i == 4 and star_rating == '4' %}
                            {% break %}
                          {% elsif i == 4 and star_rating == '4.5' %}
                            <span class="block-quote__star">{% comment %}Icon star-half:default begin{% endcomment %}
<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M11.532 1.575A.5.5 0 0 1 12 1.25v16.837l-6.232 4.569A.499.499 0 0 1 5 22.095l2.499-7.51-5.972-4.95a.5.5 0 0 1 .324-.882H9l2.533-7.177-.002-.001Z"/></svg>
{% comment %}Icon star-half:default end{% endcomment %}</span>
                            {% break %}
                          {% endif %}
                        {% endfor %}
                      </div>
                    {% endif %}
              
                    <blockquote class="block-quote__quote">
                      {{ block.settings.content }}
                      {% if author_details != blank %}
                        <footer class="blockquote block-quote__author">
                          {{ author_details }}
                        </footer>
                      {% endif %}
                    </blockquote>
                  </div>
                </div>
              </div>
              
              {% comment %}Component block-quote:default end{% endcomment %}
          {% endcase %}
        {% endfor %}
      </div>

      {% if section.blocks.size > 1 %}
        <div class="testimonials__slider-controls-mobile">
          <button
            class="
              testimonials__slider-button-mobile
              testimonials__slider-button-mobile--prev
            "
            data-testimonials-slider-previous
            aria-label="Previous Slide"
          >
            {% comment %}Icon chevron-small:default begin{% endcomment %}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 16"><path stroke="currentColor" stroke-width="1.75" d="m1 5 7 7 7-7"/></svg>
            {% comment %}Icon chevron-small:default end{% endcomment %}
          </button>
          {% capture current_slide %}<span data-testimonials-slider-current-slide="0">1</span>{% endcapture %}
          <span class="testimonials__navigation-indicator">
            {{-
              'sections.promotions_grid.navigation_html'
              | t: current_slide: current_slide, total_slide: section.blocks.size
            -}}
          </span>
          <button
            class="
              testimonials__slider-button-mobile
              testimonials__slider-button-mobile--next
            "
            data-testimonials-slider-next
            aria-label="Next Slide"
          >
            {% comment %}Icon chevron-small:default begin{% endcomment %}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 16"><path stroke="currentColor" stroke-width="1.75" d="m1 5 7 7 7-7"/></svg>
            {% comment %}Icon chevron-small:default end{% endcomment %}
          </button>
        </div>

        <button
          class="
            testimonials__slider-button-desktop 
            testimonials__slider-button-desktop--prev
          "
          data-testimonials-slider-previous
          aria-label="Previous Slide"
        >
          {% comment %}Icon arrow-long:default begin{% endcomment %}
          <svg width="30" height="31" viewBox="0 0 30 31" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="m8.715 24.5-8.55-8.537 8.55-8.537L9.977 8.69l-6.39 6.38H30v1.786H3.586l6.39 6.38-1.26 1.264Z" fill="currentColor"/></svg>
          {% comment %}Icon arrow-long:default end{% endcomment %}
        </button>
        
        <button
          class="
            testimonials__slider-button-desktop 
            testimonials__slider-button-desktop--next
          "
          data-testimonials-slider-next
          aria-label="Next Slide"
        >
          {% comment %}Icon arrow-long:default begin{% endcomment %}
          <svg width="30" height="31" viewBox="0 0 30 31" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="m8.715 24.5-8.55-8.537 8.55-8.537L9.977 8.69l-6.39 6.38H30v1.786H3.586l6.39 6.38-1.26 1.264Z" fill="currentColor"/></svg>
          {% comment %}Icon arrow-long:default end{% endcomment %}
        </button>
      {% endif %}
    </section-content>
  </section-wrapper>
</section>
{% schema %}
{
  "name": "t:common.component.testimonials",
  "settings": [
    {
      "type": "checkbox",
      "id": "wide",
      "label": "t:common.size.wide_display",
      "default": false
    },
    {
      "type": "select",
      "id": "content_display",
      "label": "t:common.layout.content_display",
      "options": [
        {
          "value": "full",
          "label": "t:common.size.full_width"
        },
        {
          "value": "centered",
          "label": "t:common.layout.centered"
        }
      ],
      "default": "full"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:component.testimonials.autoplay.label",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_duration",
      "min": 5,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:component.testimonials.autoplay_duration.label",
      "default": 5
    },
    {
      "type": "header",
      "content": "t:common.text.text"
    },
    {
      "type": "select",
      "id": "quote_size",
      "label": "t:component.testimonials.quote_size.label",
      "options": [
        {
          "value": "small",
          "label": "t:common.size.small"
        },
        {
          "value": "medium",
          "label": "t:common.size.medium"
        },
        {
          "value": "large",
          "label": "t:common.size.large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "t:common.image.image"
    },
    {
      "type": "select",
      "id": "desktop_image_height",
      "label": "t:common.image.desktop_image_height",
      "options": [
        {
          "value": "natural",
          "label": "t:common.size.natural"
        },
        {
          "value": "400",
          "label": "t:common.size.400px"
        },
        {
          "value": "500",
          "label": "t:common.size.500px"
        },
        {
          "value": "600",
          "label": "t:common.size.600px"
        },
        {
          "value": "700",
          "label": "t:common.size.700px"
        },
        {
          "value": "800",
          "label": "t:common.size.800px"
        }
      ],
      "default": "natural"
    },
    {
      "type": "select",
      "id": "mobile_image_height",
      "label": "t:common.image.mobile_image_height",
      "options": [
        {
          "value": "natural",
          "label": "t:common.size.natural"
        },
        {
          "value": "300",
          "label": "t:common.size.300px"
        },
        {
          "value": "400",
          "label": "t:common.size.400px"
        },
        {
          "value": "500",
          "label": "t:common.size.500px"
        }
      ],
      "default": "natural"
    },
    {
      "type": "header",
      "content": "t:common.style.color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:common.style.background_color",
      "default": "#F0F0F0"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:common.text.text_color",
      "default": "#222222"
    }
  ],
  "presets": [
    {
      "name": "t:common.component.testimonials",
      "blocks": [
        {
          "type": "quote"
        },
        {
          "type": "quote"
        },
        {
          "type": "quote"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "*"
    ]
  },
  "blocks": [
    {
      "type": "quote",
      "name": "t:component.block_quote.blocks.quote.name",
      "settings": [
        {
          "type": "select",
          "id": "star_rating",
          "label": "t:component.block_quote.blocks.quote.star_rating.label",
          "options": [
            {
              "value": "0",
              "label": "t:common.style.none"
            },
            {
              "value": "3.5",
              "label": "t:component.block_quote.blocks.quote.star_rating.option2"
            },
            {
              "value": "4",
              "label": "t:component.block_quote.blocks.quote.star_rating.option3"
            },
            {
              "value": "4.5",
              "label": "t:component.block_quote.blocks.quote.star_rating.option4"
            },
            {
              "value": "5",
              "label": "t:component.block_quote.blocks.quote.star_rating.option5"
            }
          ]
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:component.block_quote.blocks.quote.content.label",
          "default": "<p>Add customer reviews and testimonials to showcase your store's happy customers.</p>"
        },
        {
          "type": "richtext",
          "id": "author_details",
          "label": "t:component.block_quote.blocks.quote.author_details.label",
          "default": "<p>- Author</p>"
        },
        {
          "type": "text_alignment",
          "id": "text_alignment",
          "label": "t:common.text.text_alignment"
        },
        {
          "type": "header",
          "content": "t:common.image.image"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "t:common.image.image"
        },
        {
          "type": "url",
          "id": "image_link",
          "label": "t:component.block_quote.blocks.quote.image_link.label"
        },
        {
          "type": "select",
          "id": "desktop_image_width",
          "label": "t:common.image.image_width",
          "options": [
            {
              "value": "40",
              "label": "40%"
            },
            {
              "value": "50",
              "label": "50%"
            }
          ],
          "default": "50"
        },
        {
          "type": "select",
          "id": "desktop_image_position",
          "label": "t:common.image.desktop_image_position",
          "options": [
            {
              "value": "desktop-image-left",
              "label": "t:common.layout.left"
            },
            {
              "value": "desktop-image-right",
              "label": "t:common.layout.right"
            }
          ],
          "default": "desktop-image-right"
        },
        {
          "type": "header",
          "content": "t:common.layout.mobile"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "t:common.image.mobile_image"
        }
      ]
    }
  ]
}
{% endschema %}