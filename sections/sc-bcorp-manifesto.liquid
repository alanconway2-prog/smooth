{%- assign s = section.settings -%}

<style>
  .wlm-content .shopify-section,
  #site-main .shopify-section { margin: 0 !important; padding: 0 !important; }
  wlm.wlm-content { display: contents; }
  #site-main .shopify-section > section { margin: 0 !important; }
  #site-main { gap: 0 !important; row-gap: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
  .wlm-content { gap: 0 !important; }

  #bcm-{{ section.id }} {
    background: {{ s.m_bg }};
    color: {{ s.m_ink }};
  }
  #bcm-{{ section.id }} *,
  #bcm-{{ section.id }} {
    opacity: 1 !important; visibility: visible !important; transform: none !important; animation: none !important; clip-path: none !important;
  }

  #bcm-{{ section.id }} .bcm__wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(64px, 10vw, 140px) 24px;
  }

  /* opening */
  #bcm-{{ section.id }} .bcm__mark {
    display: block;
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0.55;
    margin: 0 0 clamp(24px, 4vw, 48px);
  }
  #bcm-{{ section.id }} .bcm__title {
    margin: 0;
    font-weight: 400;
    font-size: clamp(38px, 7vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    max-width: 16ch;
  }
  #bcm-{{ section.id }} .bcm__intro {
    margin: clamp(32px, 5vw, 64px) 0 0;
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.7;
    max-width: 58ch;
  }
  #bcm-{{ section.id }} .bcm__intro p { margin: 0 0 1em; }
  #bcm-{{ section.id }} .bcm__intro p:last-child { margin: 0; }

  /* manifesto lines */
  #bcm-{{ section.id }} .bcm__lines {
    margin-top: clamp(56px, 8vw, 112px);
    border-top: 1px solid {{ s.m_rule }};
  }
  #bcm-{{ section.id }} .bcm__line {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    padding: clamp(24px, 4vw, 44px) 0;
    border-bottom: 1px solid {{ s.m_rule }};
  }
  #bcm-{{ section.id }} .bcm__line-t {
    margin: 0;
    font-weight: 400;
    font-size: clamp(24px, 3.6vw, 44px);
    line-height: 1.08;
    letter-spacing: -0.015em;
  }
  #bcm-{{ section.id }} .bcm__line-d {
    margin: 0;
    font-size: clamp(13px, 1.4vw, 15px);
    line-height: 1.6;
    opacity: 0.7;
    max-width: 52ch;
  }
  @media screen and (min-width: 820px) {
    #bcm-{{ section.id }} .bcm__line { grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: baseline; }
  }

  /* single image moment */
  #bcm-{{ section.id }} .bcm__image {
    margin-top: clamp(56px, 8vw, 112px);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: {{ s.m_accent }};
  }
  #bcm-{{ section.id }} .bcm__image img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* pull quote */
  #bcm-{{ section.id }} .bcm__quote {
    margin: clamp(56px, 8vw, 112px) 0 0;
    font-weight: 400;
    font-size: clamp(24px, 3.6vw, 44px);
    line-height: 1.18;
    letter-spacing: -0.015em;
    max-width: 26ch;
    text-indent: -0.45em;
  }
  #bcm-{{ section.id }} .bcm__quote::before { content: '\201C'; }
  #bcm-{{ section.id }} .bcm__quote::after { content: '\201D'; }
  #bcm-{{ section.id }} .bcm__attr {
    margin-top: clamp(20px, 3vw, 32px);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  /* close */
  #bcm-{{ section.id }} .bcm__close {
    margin-top: clamp(56px, 8vw, 112px);
    padding-top: clamp(28px, 4vw, 44px);
    border-top: 1px solid {{ s.m_rule }};
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  #bcm-{{ section.id }} .bcm__close-t {
    margin: 0;
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.65;
    max-width: 52ch;
  }
  #bcm-{{ section.id }} .bcm__link {
    align-self: flex-start;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
    transition: opacity .2s;
  }
  #bcm-{{ section.id }} .bcm__link:hover { opacity: .55; }
  @media screen and (min-width: 820px) {
    #bcm-{{ section.id }} .bcm__close { flex-direction: row; justify-content: space-between; align-items: flex-end; gap: 48px; }
  }
</style>

<section id="bcm-{{ section.id }}" class="bcm" {{ section.shopify_attributes }}>
  <div class="bcm__wrap">

    {%- if s.m_mark != blank -%}<span class="bcm__mark">{{ s.m_mark }}</span>{%- endif -%}
    {%- if s.m_title != blank -%}<h1 class="bcm__title">{{ s.m_title }}</h1>{%- endif -%}
    {%- if s.m_intro != blank -%}<div class="bcm__intro rte">{{ s.m_intro }}</div>{%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="bcm__lines">
        {%- for block in section.blocks -%}
          <div class="bcm__line" {{ block.shopify_attributes }}>
            <h2 class="bcm__line-t">{{ block.settings.t }}</h2>
            {%- if block.settings.d != blank -%}<p class="bcm__line-d">{{ block.settings.d }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.m_image != blank -%}
      <div class="bcm__image">
        {{ s.m_image | image_url: width: 2200 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 1032px, 100vw', widths: '600, 1000, 1500, 2200', alt: s.m_title | escape }}
      </div>
    {%- endif -%}

    {%- if s.m_quote != blank -%}
      <blockquote class="bcm__quote">{{ s.m_quote }}</blockquote>
      {%- if s.m_attr != blank -%}<p class="bcm__attr">{{ s.m_attr }}</p>{%- endif -%}
    {%- endif -%}

    {%- if s.m_close != blank or s.m_link_text != blank -%}
      <div class="bcm__close">
        {%- if s.m_close != blank -%}<p class="bcm__close-t">{{ s.m_close }}</p>{%- endif -%}
        {%- if s.m_link_text != blank and s.m_link_url != blank -%}
          <a class="bcm__link" href="{{ s.m_link_url }}" target="_blank" rel="noopener">{{ s.m_link_text }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "B Corp manifesto",
  "tag": "section",
  "class": "bcm-section",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "m_mark", "label": "Top mark", "default": "Certified B Corporation" },
    { "type": "textarea", "id": "m_title", "label": "Headline", "default": "We're making glossy waves, for all the right reasons." },
    { "type": "richtext", "id": "m_intro", "label": "Intro", "default": "<p>We didn't start The Smooth Company to just make good hair days happen, we started it to help every day run that little bit smoother. Becoming a Certified B Corporation isn't a badge we're bolting on, it's proof of something we've believed since the beginning: that a smooth day for you shouldn't come at a cost to anyone else's.</p><p>We've been independently assessed on how we treat our people, our planet, and our customers, and we came through it. Not by scraping by, but because doing things properly has never been optional for us.</p>" },
    { "type": "image_picker", "id": "m_image", "label": "Image", "info": "One image. Team, founder, or product in the wild." },
    { "type": "textarea", "id": "m_quote", "label": "Founder quote", "default": "The Smooth Company was never just about creating products people love. It was about building a business that could make a positive impact." },
    { "type": "text", "id": "m_attr", "label": "Attribution", "default": "Áine Kennedy, Founder and CEO" },
    { "type": "textarea", "id": "m_close", "label": "Closing line", "default": "None of this happens without you. This certification is as much yours as it is ours." },
    { "type": "text", "id": "m_link_text", "label": "Link text", "default": "Learn more about B Corp" },
    { "type": "url", "id": "m_link_url", "label": "Link URL" },
    { "type": "header", "content": "Colour" },
    { "type": "color", "id": "m_bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "m_ink", "label": "Ink", "default": "#1d1d1b" },
    { "type": "color", "id": "m_rule", "label": "Rules", "default": "#e4e1d9" },
    { "type": "color", "id": "m_accent", "label": "Image placeholder", "default": "#b5e3d9" }
  ],
  "blocks": [
    {
      "type": "line",
      "name": "Manifesto line",
      "settings": [
        { "type": "text", "id": "t", "label": "Statement", "default": "People over profit." },
        { "type": "textarea", "id": "d", "label": "Detail", "info": "Optional small text beside it." }
      ]
    }
  ],
  "presets": [
    {
      "name": "B Corp manifesto",
      "blocks": [
        { "type": "line", "settings": { "t": "People over profit.", "d": "An all-female team behind every formula, every decision, every Smooth step. Compensated fairly, heard always." } },
        { "type": "line", "settings": { "t": "Made in Ireland.", "d": "Working hand in hand with our chemists, so we're always close to the science, and closer to you." } },
        { "type": "line", "settings": { "t": "Smooth for everyone.", "d": "Every hair type, every texture, every experience level. If it doesn't work for everyone, it doesn't make the cut." } },
        { "type": "line", "settings": { "t": "Zero single-use plastic.", "d": "100% FSC-certified packaging, renewable wherever we can. No exceptions." } },
        { "type": "line", "settings": { "t": "Better, even when better takes longer.", "d": "Certification is reviewed every three years, and we're not planning to stand still in between." } }
      ]
    }
  ]
}
{% endschema %}
