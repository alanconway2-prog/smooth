{% comment %}
  SOAP. / The Smooth Company
  sc-bcorp-banner

  Setting ids are prefixed bb_ so stale values from any earlier section
  cannot map onto them.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign alt_logo = s.bb_logo.alt | default: 'Certified B Corporation'
  assign alt_bg = s.bb_image.alt | default: 'Certified B Corporation'
  assign body = s.bb_text | strip
-%}

<style>
  /* Page scoped section gap reset */
  .wlm-content .shopify-section,
  #site-main .shopify-section { margin: 0 !important; padding: 0 !important; }
  wlm.wlm-content { display: contents; }
  #site-main .shopify-section > section { margin: 0 !important; }
  #site-main { gap: 0 !important; row-gap: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
  .wlm-content { gap: 0 !important; }

  #scbb-{{ section.id }} {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    min-height: {{ s.bb_h_m }}px;
    padding: {{ s.bb_pad_m }}px 24px;
    overflow: hidden;
    background-color: {{ s.bb_bg }};
    color: {{ s.bb_ink }};
  }

  #scbb-{{ section.id }} .scbb__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #scbb-{{ section.id }} .scbb__scrim {
    position: absolute;
    inset: 0;
    background-color: {{ s.bb_scrim }};
    opacity: {{ s.bb_scrim_op | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 0;
  }

  #scbb-{{ section.id }} .scbb__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: {{ s.bb_gap }}px;
    max-width: 560px;
    text-align: center;
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    animation: none !important;
  }

  #scbb-{{ section.id }} .scbb__inner,
  #scbb-{{ section.id }} .scbb__inner * {
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    animation: none !important;
    clip-path: none !important;
  }

  #scbb-{{ section.id }} .scbb__logo {
    display: block;
    width: {{ s.bb_logo_w_m }}px;
    height: auto;
    margin: 0;
  }

  #scbb-{{ section.id }} .scbb__text {
    margin: 0;
    font-size: {{ s.bb_ts_m }}px;
    line-height: 1.5;
    opacity: 1 !important;
    transform: none !important;
  }

  @media screen and (min-width: 768px) {
    #scbb-{{ section.id }} {
      min-height: {{ s.bb_h_d }}px;
      padding: {{ s.bb_pad_d }}px 48px;
    }
    #scbb-{{ section.id }} .scbb__logo {
      width: {{ s.bb_logo_w_d }}px;
    }
    #scbb-{{ section.id }} .scbb__text {
      font-size: {{ s.bb_ts_d }}px;
    }
  }
</style>

<section id="scbb-{{ section.id }}" class="scbb" {{ section.shopify_attributes }}>
  {%- if s.bb_image != blank -%}
    {{
      s.bb_image
      | image_url: width: 2400
      | image_tag: loading: 'eager', sizes: '100vw', widths: '800, 1200, 1800, 2400', alt: alt_bg, class: 'scbb__bg'
    }}
  {%- endif -%}

  {%- if s.bb_scrim_op > 0 -%}
    <div class="scbb__scrim"></div>
  {%- endif -%}

  <div class="scbb__inner">
    {%- if s.bb_logo != blank -%}
      {{
        s.bb_logo
        | image_url: width: 500
        | image_tag: loading: 'eager', widths: '120, 240, 360, 500', alt: alt_logo, class: 'scbb__logo'
      }}
    {%- endif -%}

    {%- if body != blank -%}
      <p class="scbb__text">{{ body }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "B Corp: Banner",
  "tag": "section",
  "class": "scbb-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bb_logo",
      "label": "B Corp logo"
    },
    {
      "type": "textarea",
      "id": "bb_text",
      "label": "Text below logo",
      "info": "Leave empty and the logo centres on its own.",
      "default": "Measured, verified and held to account. Not because it looks good, but because it is the only honest way to make what we make."
    },
    {
      "type": "range",
      "id": "bb_gap",
      "label": "Gap between logo and text",
      "min": 0,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "bb_logo_w_d",
      "label": "Logo width, desktop",
      "min": 20,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "bb_logo_w_m",
      "label": "Logo width, mobile",
      "min": 20,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "bb_h_d",
      "label": "Minimum height, desktop",
      "min": 0,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "bb_h_m",
      "label": "Minimum height, mobile",
      "min": 0,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "bb_pad_d",
      "label": "Padding, desktop",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "bb_pad_m",
      "label": "Padding, mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colour and type"
    },
    {
      "type": "image_picker",
      "id": "bb_image",
      "label": "Background image",
      "info": "Optional. Leave empty for a flat colour."
    },
    {
      "type": "color",
      "id": "bb_bg",
      "label": "Background colour",
      "default": "#1d1d1b"
    },
    {
      "type": "color",
      "id": "bb_scrim",
      "label": "Overlay colour",
      "default": "#1d1d1b"
    },
    {
      "type": "range",
      "id": "bb_scrim_op",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 0
    },
    {
      "type": "color",
      "id": "bb_ink",
      "label": "Text colour",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "bb_ts_d",
      "label": "Text size, desktop",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "bb_ts_m",
      "label": "Text size, mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "B Corp: Banner"
    }
  ]
}
{% endschema %}
