{% comment %}
  SOAP. / The Smooth Company
  sc-bcorp-grid

  One section, three jobs:
  - Stats: 2 columns, large titles, short bodies
  - The Smooth Print: 2 columns, titles and bodies
  - Why B Corp Matters: 4 columns, title only, background image

  Setting ids are prefixed bg_ and block ids bgi_ so nothing stale can map on.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign alt_bg = s.bg_image.alt | default: s.bg_heading | escape
  assign eyebrow = s.bg_eyebrow | strip
  assign heading = s.bg_heading | strip
-%}

<style>
  /* Page scoped section gap reset */
  .wlm-content .shopify-section,
  #site-main .shopify-section { margin: 0 !important; padding: 0 !important; }
  wlm.wlm-content { display: contents; }
  #site-main .shopify-section > section { margin: 0 !important; }
  #site-main { gap: 0 !important; row-gap: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
  .wlm-content { gap: 0 !important; }

  #scbg-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background-color: {{ s.bg_bg }};
    color: {{ s.bg_ink }};
    padding: {{ s.bg_pad_m }}px 24px;
  }

  #scbg-{{ section.id }} .scbg__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  #scbg-{{ section.id }} .scbg__scrim {
    position: absolute;
    inset: 0;
    background-color: {{ s.bg_scrim }};
    opacity: {{ s.bg_scrim_op | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 1;
  }

  #scbg-{{ section.id }} .scbg__inner {
    position: relative;
    z-index: 2;
    max-width: {{ s.bg_max }}px;
    margin: 0 auto;
  }

  /* Tailor hides content until its observer fires. Force everything visible. */
  #scbg-{{ section.id }} .scbg__inner,
  #scbg-{{ section.id }} .scbg__inner * {
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    animation: none !important;
    clip-path: none !important;
  }

  #scbg-{{ section.id }} .scbg__eyebrow,
  #scbg-{{ section.id }} .scbg__heading,
  #scbg-{{ section.id }} .scbg__title,
  #scbg-{{ section.id }} .scbg__body {
    margin: 0;
    padding: 0;
  }

  #scbg-{{ section.id }} .scbg__eyebrow {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6 !important;
    text-align: {{ s.bg_head_align }};
  }

  #scbg-{{ section.id }} .scbg__heading {
    margin-top: {{ s.bg_gap_eyebrow }}px;
    font-size: {{ s.bg_heading_size_m }}px;
    line-height: 1.15;
    font-weight: 400;
    text-align: {{ s.bg_head_align }};
  }

  #scbg-{{ section.id }} .scbg__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ s.bg_row_gap }}px {{ s.bg_col_gap }}px;
    margin-top: {{ s.bg_gap_heading }}px;
  }

  #scbg-{{ section.id }} .scbg__item {
    text-align: {{ s.bg_item_align }};
    {% if s.bg_dividers %}
      border-top: 1px solid currentColor;
      padding-top: {{ s.bg_row_gap | divided_by: 2 }}px;
    {% endif %}
  }

  #scbg-{{ section.id }} .scbg__title {
    font-size: {{ s.bg_title_size_m }}px;
    line-height: 1.15;
    font-weight: {{ s.bg_title_weight }};
    {% if s.bg_title_caps %}
      text-transform: uppercase;
      letter-spacing: 0.08em;
    {% endif %}
  }

  #scbg-{{ section.id }} .scbg__body {
    margin-top: {{ s.bg_gap_title }}px;
    font-size: {{ s.bg_body_size_m }}px;
    line-height: 1.55;
    opacity: 0.85 !important;
  }

  @media screen and (min-width: 768px) {
    #scbg-{{ section.id }} {
      padding: {{ s.bg_pad_d }}px 48px;
    }
    #scbg-{{ section.id }} .scbg__heading {
      font-size: {{ s.bg_heading_size_d }}px;
    }
    #scbg-{{ section.id }} .scbg__grid {
      grid-template-columns: repeat({{ s.bg_cols }}, minmax(0, 1fr));
    }
    #scbg-{{ section.id }} .scbg__title {
      font-size: {{ s.bg_title_size_d }}px;
    }
    #scbg-{{ section.id }} .scbg__body {
      font-size: {{ s.bg_body_size_d }}px;
    }
  }
</style>

<section id="scbg-{{ section.id }}" class="scbg" {{ section.shopify_attributes }}>
  {%- if s.bg_image != blank -%}
    {{
      s.bg_image
      | image_url: width: 2400
      | image_tag: loading: 'lazy', sizes: '100vw', widths: '800, 1200, 1800, 2400', alt: alt_bg, class: 'scbg__bg'
    }}
  {%- endif -%}

  {%- if s.bg_scrim_op > 0 -%}
    <div class="scbg__scrim"></div>
  {%- endif -%}

  <div class="scbg__inner">
    {%- if eyebrow != blank -%}
      <p class="scbg__eyebrow">{{ eyebrow }}</p>
    {%- endif -%}

    {%- if heading != blank -%}
      <h2 class="scbg__heading">{{ heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="scbg__grid">
        {%- for block in section.blocks -%}
          {%- assign bt = block.settings.bgi_title | strip -%}
          {%- assign bb = block.settings.bgi_body | strip -%}
          <div class="scbg__item" {{ block.shopify_attributes }}>
            {%- if bt != blank -%}
              <p class="scbg__title">{{ bt }}</p>
            {%- endif -%}
            {%- if bb != blank and s.bg_title_only == false -%}
              <p class="scbg__body">{{ bb }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "B Corp: Grid",
  "tag": "section",
  "class": "scbg-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "bg_eyebrow",
      "label": "Eyebrow",
      "info": "Leave empty to hide."
    },
    {
      "type": "text",
      "id": "bg_heading",
      "label": "Heading",
      "info": "Leave empty to hide."
    },
    {
      "type": "select",
      "id": "bg_head_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "select",
      "id": "bg_cols",
      "label": "Columns, desktop",
      "info": "Always one column on mobile.",
      "options": [
        { "value": "2", "label": "Two" },
        { "value": "3", "label": "Three" },
        { "value": "4", "label": "Four" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "bg_title_only",
      "label": "Titles only, hide body text",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bg_dividers",
      "label": "Rule above each item",
      "default": false
    },
    {
      "type": "select",
      "id": "bg_item_align",
      "label": "Item alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "bg_title_caps",
      "label": "Uppercase titles",
      "default": false
    },
    {
      "type": "select",
      "id": "bg_title_weight",
      "label": "Title weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "bg_gap_eyebrow",
      "label": "Gap under eyebrow",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "bg_gap_heading",
      "label": "Gap under heading",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "bg_gap_title",
      "label": "Gap under item title",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "bg_col_gap",
      "label": "Gap between columns",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "bg_row_gap",
      "label": "Gap between rows",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "bg_pad_d",
      "label": "Section padding, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "bg_pad_m",
      "label": "Section padding, mobile",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "bg_max",
      "label": "Content max width",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1120
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "bg_bg",
      "label": "Background colour",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_ink",
      "label": "Text colour",
      "default": "#1d1d1b"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "info": "Optional. Use with an overlay for the pillars section."
    },
    {
      "type": "color",
      "id": "bg_scrim",
      "label": "Overlay colour",
      "default": "#1d1d1b"
    },
    {
      "type": "range",
      "id": "bg_scrim_op",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "Type sizes"
    },
    {
      "type": "range",
      "id": "bg_heading_size_d",
      "label": "Heading size, desktop",
      "min": 18,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "bg_heading_size_m",
      "label": "Heading size, mobile",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "bg_title_size_d",
      "label": "Item title size, desktop",
      "min": 12,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "bg_title_size_m",
      "label": "Item title size, mobile",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "bg_body_size_d",
      "label": "Item body size, desktop",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "bg_body_size_m",
      "label": "Item body size, mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "bgi_title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "bgi_body",
          "label": "Body"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "B Corp: Grid",
      "blocks": [
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
