{% comment %}
  SOAP. / The Smooth Company
  sc-bcorp-close
  Closing pledge lines, then up to two links. Blocks are the pledge lines.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign alt_logo = s.logo.alt | default: 'Certified B Corporation'
-%}

<style>
  #sc-bcorp-close-{{ section.id }} {
    background-color: {{ s.background_color }};
    color: {{ s.text_color }};
    padding-top: {{ s.padding_top | times: 0.6 | round }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.6 | round }}px;
  }

  #sc-bcorp-close-{{ section.id }} .sc-bcorp-close__inner {
    max-width: {{ s.content_width }}px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  #sc-bcorp-close-{{ section.id }} .sc-bcorp-close__logo {
    display: block;
    width: {{ s.logo_width }}px;
    height: auto;
    margin: 0 auto 32px;
  }

  #sc-bcorp-close-{{ section.id }} .sc-bcorp-close__heading {
    margin: 0 0 32px;
    font-size: {{ s.heading_size_mobile }}px;
    line-height: 1.15;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  #sc-bcorp-close-{{ section.id }} .sc-bcorp-close__lines {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #sc-bcorp-close-{{ section.id }} .sc-bcorp-close__line {
    margin: 0;
    padding: 18px 0;
    font-size: {{ s.line_size_mobile }}px;
    line-height: 1.35;
    border-top: 1px solid currentColor;
  }

  #sc-bcorp-close-{{ section.id }} .sc-bcorp-close__line:last-child {
    border-bottom: 1px solid currentColor;
  }

  #sc-bcorp-close-{{ section.id }} .sc-bcorp-close__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
  }

  #sc-bcorp-close-{{ section.id }} .sc-bcorp-close__link {
    display: inline-block;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
    transition: opacity 0.2s ease;
  }

  #sc-bcorp-close-{{ section.id }} .sc-bcorp-close__link:hover {
    opacity: 0.6;
  }

  @media screen and (min-width: 768px) {
    #sc-bcorp-close-{{ section.id }} {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
    #sc-bcorp-close-{{ section.id }} .sc-bcorp-close__inner {
      padding: 0 48px;
    }
    #sc-bcorp-close-{{ section.id }} .sc-bcorp-close__heading {
      font-size: {{ s.heading_size_desktop }}px;
    }
    #sc-bcorp-close-{{ section.id }} .sc-bcorp-close__line {
      font-size: {{ s.line_size_desktop }}px;
      padding: 26px 0;
    }
    #sc-bcorp-close-{{ section.id }} .sc-bcorp-close__links {
      flex-direction: row;
      justify-content: center;
      gap: 40px;
      margin-top: 56px;
    }
  }
</style>

<section
  id="sc-bcorp-close-{{ section.id }}"
  class="sc-bcorp-close"
  {{ section.shopify_attributes }}
>
  <div class="sc-bcorp-close__inner">
    {%- if s.logo != blank -%}
      {{
        s.logo
        | image_url: width: 400
        | image_tag:
          loading: 'lazy',
          widths: '100, 200, 300, 400',
          alt: alt_logo,
          class: 'sc-bcorp-close__logo'
      }}
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h2 class="sc-bcorp-close__heading">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="sc-bcorp-close__lines">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <li class="sc-bcorp-close__line" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if s.link_one_text != blank or s.link_two_text != blank -%}
      <div class="sc-bcorp-close__links">
        {%- if s.link_one_text != blank and s.link_one_url != blank -%}
          <a
            class="sc-bcorp-close__link"
            href="{{ s.link_one_url }}"
            {% if s.link_one_new_tab %}target="_blank" rel="noopener"{% endif %}
          >
            {{ s.link_one_text }}
          </a>
        {%- endif -%}

        {%- if s.link_two_text != blank and s.link_two_url != blank -%}
          <a
            class="sc-bcorp-close__link"
            href="{{ s.link_two_url }}"
            {% if s.link_two_new_tab %}target="_blank" rel="noopener"{% endif %}
          >
            {{ s.link_two_text }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "B Corp: Close",
  "tag": "section",
  "class": "sc-bcorp-close-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "B Corp logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 30,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 55
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where we will not compromise"
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "text",
      "id": "link_one_text",
      "label": "Link one text",
      "default": "Read our impact report"
    },
    {
      "type": "url",
      "id": "link_one_url",
      "label": "Link one URL"
    },
    {
      "type": "checkbox",
      "id": "link_one_new_tab",
      "label": "Open link one in a new tab",
      "default": true
    },
    {
      "type": "text",
      "id": "link_two_text",
      "label": "Link two text",
      "default": "About B Corp certification"
    },
    {
      "type": "url",
      "id": "link_two_url",
      "label": "Link two URL"
    },
    {
      "type": "checkbox",
      "id": "link_two_new_tab",
      "label": "Open link two in a new tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content max width",
      "min": 480,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 700
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Colour and type"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#b5e3d9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1d1d1b"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size, desktop",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size, mobile",
      "min": 18,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "line_size_desktop",
      "label": "Line size, desktop",
      "min": 16,
      "max": 34,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "line_size_mobile",
      "label": "Line size, mobile",
      "min": 14,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 18
    }
  ],
  "blocks": [
    {
      "type": "line",
      "name": "Pledge line",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Line",
          "default": "We will always choose the formula that works over the one that sells."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "B Corp: Close",
      "blocks": [
        { "type": "line" },
        { "type": "line" },
        { "type": "line" }
      ]
    }
  ]
}
{% endschema %}
