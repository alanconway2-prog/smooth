{% comment %}
  Smooth Company — Watch & shop (custom)
  Full-bleed 9:16 tiles, 2px gaps, play glyph, title + "Shop £xx" chip.
  Every tile routes to a PDP (or any link). Each tile can hold a looping video
  (muted, plays on tap/hover) with a poster image, or just a still.
{% endcomment %}
<style>
  #shopify-section-{{ section.id }} .sc-watch { padding: {{ section.settings.padding_top }}px 0 0; background: {{ section.settings.background_color }}; }
  #shopify-section-{{ section.id }} .sc-watch__eyebrow {
    font-family: 'Gotham Medium', sans-serif; font-size: 12px; letter-spacing: 0.24em;
    text-transform: uppercase; font-weight: 600; text-align: center; color: #1d1d1b; margin: 0 0 24px;
  }
  #shopify-section-{{ section.id }} .sc-watch__track {
    display: flex; gap: 2px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
  }
  #shopify-section-{{ section.id }} .sc-watch__track::-webkit-scrollbar { height: 0; }
  #shopify-section-{{ section.id }} .sc-watch__tile { flex: 0 0 240px; scroll-snap-align: start; }
  #shopify-section-{{ section.id }} .sc-watch__media {
    aspect-ratio: 9/16; position: relative; overflow: hidden; display: block;
    background: repeating-linear-gradient(120deg,#e6e2dc 0 15px,#eee9e3 15px 30px);
  }
  #shopify-section-{{ section.id }} .sc-watch__media img,
  #shopify-section-{{ section.id }} .sc-watch__media video { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .sc-watch__play {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
    width: 44px; height: 44px; border-radius: 100px; background: rgba(255,255,255,0.9);
    display: flex; align-items: center; justify-content: center; font-size: 12px; color: #1d1d1b; z-index: 2;
  }
  #shopify-section-{{ section.id }} .sc-watch__title {
    position: absolute; left: 14px; right: 14px; bottom: 52px; color: #fff; z-index: 2;
    font-family: 'Gotham Medium', sans-serif; font-size: 13px; font-weight: 500; line-height: 1.2;
    text-shadow: 0 1px 5px rgba(0,0,0,0.5);
  }
  #shopify-section-{{ section.id }} .sc-watch__chip {
    position: absolute; left: 14px; bottom: 14px; z-index: 2; background: #fff; color: #1d1d1b;
    padding: 8px 14px; font-family: 'Gotham Medium', sans-serif; font-size: 10px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .sc-watch__viewall { display: none; }
  #shopify-section-{{ section.id }} .sc-watch__viewall-label {
    font-family: 'Gotham Medium', sans-serif; font-size: 12px; letter-spacing: 0.2em;
    text-transform: uppercase; color: #1d1d1b; border-bottom: 1px solid #1d1d1b; padding-bottom: 3px;
  }
  /* Tablet & desktop: rail becomes a grid (2-up → 4-up) with a View all tile */
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .sc-watch { padding-top: calc({{ section.settings.padding_top }}px * 1.35); }
    #shopify-section-{{ section.id }} .sc-watch__eyebrow { font-size: 13px; margin-bottom: 30px; }
    #shopify-section-{{ section.id }} .sc-watch__track {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; overflow: visible; padding: 0 24px;
    }
    #shopify-section-{{ section.id }} .sc-watch__tile { flex: none; scroll-snap-align: none; }
    #shopify-section-{{ section.id }} .sc-watch__viewall { display: flex; align-items: center; justify-content: center; background: #f4f4f2; }
    #shopify-section-{{ section.id }} .sc-watch__play { width: 52px; height: 52px; font-size: 14px; }
    #shopify-section-{{ section.id }} .sc-watch__title { font-size: 15px; left: 18px; right: 18px; bottom: 60px; }
    #shopify-section-{{ section.id }} .sc-watch__chip { font-size: 11px; left: 18px; bottom: 18px; padding: 9px 15px; }
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .sc-watch__track { grid-template-columns: repeat(4, 1fr); padding: 0 48px; }
  }
</style>
<div class="sc-watch">
  {%- if section.settings.eyebrow != blank -%}
    <p class="sc-watch__eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  <div class="sc-watch__track">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <a class="sc-watch__tile" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <span class="sc-watch__media">
            {%- if block.settings.video != blank -%}
              <video autoplay muted loop playsinline preload="none"{% if block.settings.image != blank %} poster="{{ block.settings.image | image_url: width: 560 }}"{% endif %}>
                {%- for source in block.settings.video.sources -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
              </video>
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 560 | image_tag: loading: 'lazy', sizes: '240px', widths: '240, 360, 480, 560', alt: block.settings.title }}
              <span class="sc-watch__play">▶</span>
            {%- else -%}
              <span class="sc-watch__play">▶</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}<span class="sc-watch__title">{{ block.settings.title }}</span>{%- endif -%}
            {%- if block.settings.price != blank -%}<span class="sc-watch__chip">Shop {{ block.settings.price }}</span>{%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- assign pht = 'Tame flyaways in 60s|£24,The polished slick|£22,Travel-ready hair|£30' | split: ',' -%}
      {%- for item in pht -%}
        {%- assign parts = item | split: '|' -%}
        <a class="sc-watch__tile" href="#">
          <span class="sc-watch__media">
            <span class="sc-watch__play">▶</span>
            <span class="sc-watch__title">{{ parts[0] }}</span>
            <span class="sc-watch__chip">Shop {{ parts[1] }}</span>
          </span>
        </a>
      {%- endfor -%}
    {%- endif -%}
    {%- if section.settings.view_all_label != blank -%}
      <a class="sc-watch__tile sc-watch__viewall" href="{{ section.settings.view_all_link | default: '#' }}">
        <span class="sc-watch__viewall-label">{{ section.settings.view_all_label }}</span>
      </a>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "SC Watch & shop",
  "tag": "section",
  "class": "sc-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Watch & shop" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top spacing", "default": 72 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "header", "content": "View all tile (desktop)" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all", "info": "Shows as an extra tile on desktop. Leave empty to hide." },
    { "type": "url", "id": "view_all_link", "label": "View all link" }
  ],
  "blocks": [
    {
      "type": "clip",
      "name": "Clip",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (muted loop, 9:16)" },
        { "type": "image_picker", "id": "image", "label": "Poster / still image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Tame flyaways in 60s" },
        { "type": "text", "id": "price", "label": "Price chip", "default": "£24" },
        { "type": "url", "id": "link", "label": "Link (to product)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SC Watch & shop",
      "blocks": [
        { "type": "clip", "settings": { "title": "Tame flyaways in 60s", "price": "£24" } },
        { "type": "clip", "settings": { "title": "The polished slick", "price": "£22" } },
        { "type": "clip", "settings": { "title": "Travel-ready hair", "price": "£30" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
