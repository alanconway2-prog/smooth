{% comment %}
  Smooth Company — Best sellers rail "10A" (custom)
  Big left title + "View all", optional tab switcher (each tab a collection, no reload),
  then a product rail: mobile = one large card + peek of the next; desktop = a row that
  fills the width (4 or 6 per row, a setting) with prev/next arrows.
  Cards render via snippets/sc-product-card.liquid. Add-to-cart posts to the theme cart.
{% endcomment %}

{%- liquid
  assign tabs = section.blocks | where: 'type', 'tab'
  assign cols = section.settings.columns_desktop | plus: 0
  assign gap_total = cols | minus: 1 | times: 2
  assign ar = '4/5'
  if section.settings.card_shape == 'square'
    assign ar = '1/1'
  endif
  assign align = section.settings.heading_alignment
-%}

<style>
  #shopify-section-{{ section.id }} .sc-rail {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
    --sc-card-ar: {{ ar }};
    --sc-badge-bg: {{ section.settings.badge_color }};
    --sc-badge-fg: {{ section.settings.badge_text_color }};
    --sc-add-bg: {{ section.settings.add_button_color }};
  }
  /* Section header (big left title + View all) */
  #shopify-section-{{ section.id }} .sc-rail__head {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 20px;
    padding: 0 20px 24px; text-align: {{ align }};
  }
  {% if align == 'center' %}#shopify-section-{{ section.id }} .sc-rail__head { justify-content: center; }{% endif %}
  #shopify-section-{{ section.id }} .sc-rail__title {
    font-family: 'Gotham', sans-serif; font-weight: 700; text-transform: none;
    font-size: 25px; letter-spacing: -0.02em; line-height: 1; margin: 0; color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .sc-rail__viewall {
    flex: 0 0 auto; font-family: 'Gotham Medium', sans-serif; font-size: 11px;
    letter-spacing: 0.16em; text-transform: uppercase; color: #1d1d1b;
    border-bottom: 1px solid #1d1d1b; padding-bottom: 3px; white-space: nowrap;
  }
  /* Tabs */
  #shopify-section-{{ section.id }} .sc-rail__tabs {
    display: flex; gap: 22px; flex-wrap: wrap; padding: 0 20px 18px;
    justify-content: {% if align == 'center' %}center{% elsif align == 'right' %}flex-end{% else %}flex-start{% endif %};
  }
  #shopify-section-{{ section.id }} .sc-rail__tab {
    background: none; border: none; padding: 0 0 6px; margin: 0; cursor: pointer;
    font-family: 'Gotham Medium', sans-serif; font-size: 12px; letter-spacing: 0.08em;
    text-transform: uppercase; color: #9A9A94; font-weight: 500; transition: color .18s;
  }
  #shopify-section-{{ section.id }} .sc-rail__tab.is-active {
    color: #1d1d1b; font-weight: 600; border-bottom: 1.5px solid #1d1d1b;
  }
  #shopify-section-{{ section.id }} .sc-rail__panel { display: none; }
  #shopify-section-{{ section.id }} .sc-rail__panel.is-active { display: block; }
  /* Rail track */
  #shopify-section-{{ section.id }} .sc-rail__track {
    display: flex; gap: 10px; overflow-x: auto; padding: 0 20px;
    scroll-snap-type: x mandatory; scroll-padding-left: 20px; -webkit-overflow-scrolling: touch;
  }
  #shopify-section-{{ section.id }} .sc-rail__track::-webkit-scrollbar { height: 0; }
  #shopify-section-{{ section.id }} .sc-pcard { flex: 0 0 calc(100% - 110px); scroll-snap-align: start; }

  /* ---- Product card ---- */
  #shopify-section-{{ section.id }} .sc-pcard__media {
    aspect-ratio: var(--sc-card-ar); background: #f4f3f0; position: relative; overflow: hidden;
  }
  #shopify-section-{{ section.id }} .sc-pcard__link { display: block; width: 100%; height: 100%; }
  #shopify-section-{{ section.id }} .sc-pcard__media img,
  #shopify-section-{{ section.id }} .sc-pcard__ph { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .sc-pcard__ph { background: repeating-linear-gradient(120deg,#eef0ee 0 13px,#f6f7f5 13px 26px); }
  #shopify-section-{{ section.id }} .sc-pcard__badge {
    position: absolute; top: 0; left: 0; z-index: 2;
    font-family: 'Gotham Medium', sans-serif; font-size: 8px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--sc-badge-fg); background: var(--sc-badge-bg); padding: 5px 9px;
  }
  #shopify-section-{{ section.id }} .sc-pcard__form { margin: 0; }
  #shopify-section-{{ section.id }} .sc-pcard__add {
    position: absolute; bottom: 12px; right: 12px; z-index: 2;
    width: 32px; height: 32px; border-radius: 100px; border: none;
    background: var(--sc-add-bg); color: #fff; font-size: 16px; line-height: 1;
    cursor: pointer; display: flex; align-items: center; justify-content: center; transition: transform .12s, opacity .18s;
  }
  #shopify-section-{{ section.id }} .sc-pcard__add:hover { transform: scale(1.08); }
  #shopify-section-{{ section.id }} .sc-pcard__add.is-soldout { opacity: .4; cursor: default; }
  #shopify-section-{{ section.id }} .sc-pcard__add.is-loading { opacity: .6; cursor: progress; }
  #shopify-section-{{ section.id }} .sc-pcard__meta { padding: 10px 10px 0; }
  #shopify-section-{{ section.id }} .sc-pcard__name {
    display: block; font-family: 'Gotham Medium', sans-serif; font-size: 12.5px; font-weight: 600;
    line-height: 1.2; text-transform: uppercase; letter-spacing: 0.03em; color: #1d1d1b; text-decoration: none;
  }
  #shopify-section-{{ section.id }} .sc-pcard__stars { font-size: 10px; color: #8A8A84; margin-top: 5px; letter-spacing: .04em; }
  #shopify-section-{{ section.id }} .sc-pcard__stars { color: #1d1d1b; }
  #shopify-section-{{ section.id }} .sc-pcard__count { color: #8A8A84; text-decoration: underline; }
  #shopify-section-{{ section.id }} .sc-pcard__price { margin-top: 5px; }
  #shopify-section-{{ section.id }} .sc-pcard__price .price {
    font-family: 'Gotham Medium', sans-serif; font-size: 12.5px; color: #1d1d1b;
    display: flex; align-items: baseline; gap: 7px; flex-wrap: wrap;
  }
  #shopify-section-{{ section.id }} .sc-pcard__price s,
  #shopify-section-{{ section.id }} .sc-pcard__price .price__sale-compare { font-size: 11px; color: #A8A8A2; text-decoration: line-through; }
  #shopify-section-{{ section.id }} .sc-pcard__price .price__savings { font-size: 9px; letter-spacing: .1em; text-transform: uppercase; color: #0f3d51; }

  /* Arrows (desktop) */
  #shopify-section-{{ section.id }} .sc-rail__arrows { display: none; }
  #shopify-section-{{ section.id }} .sc-rail__arrow {
    width: 44px; height: 44px; border: 1px solid #1d1d1b; background: #fff; color: #1d1d1b;
    cursor: pointer; font-size: 16px; line-height: 1;
  }
  #shopify-section-{{ section.id }} .sc-rail__arrow--next { background: #1d1d1b; color: #fff; }

  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .sc-rail { padding-top: {{ section.settings.padding_top_desktop }}px; padding-bottom: {{ section.settings.padding_bottom_desktop }}px; }
    #shopify-section-{{ section.id }} .sc-rail__head { padding: 0 48px 34px; }
    #shopify-section-{{ section.id }} .sc-rail__title { font-size: 34px; }
    #shopify-section-{{ section.id }} .sc-rail__tabs { padding: 0 48px 22px; gap: 30px; }
    #shopify-section-{{ section.id }} .sc-rail__track { gap: 2px; padding: 0 48px; scroll-padding-left: 48px; }
    #shopify-section-{{ section.id }} .sc-pcard { flex: 0 0 calc((100% - {{ gap_total }}px) / {{ cols }}); }
    #shopify-section-{{ section.id }} .sc-pcard__badge { font-size: 9px; }
    #shopify-section-{{ section.id }} .sc-pcard__add { width: 40px; height: 40px; font-size: 19px; }
    #shopify-section-{{ section.id }} .sc-pcard__meta { padding: 12px 12px 0; }
    #shopify-section-{{ section.id }} .sc-pcard__name { font-size: 14px; }
    #shopify-section-{{ section.id }} .sc-pcard__stars { font-size: 11px; }
    #shopify-section-{{ section.id }} .sc-pcard__price .price { font-size: 14px; }
    {% if section.settings.show_arrows %}
    #shopify-section-{{ section.id }} .sc-rail__arrows { display: flex; align-items: center; justify-content: space-between; padding: 26px 48px 0; }
    {% endif %}
    #shopify-section-{{ section.id }} .sc-rail__rule { flex: 1; height: 1px; background: #efefec; margin-right: 16px; }
    #shopify-section-{{ section.id }} .sc-rail__arrowset { display: flex; gap: 8px; }
  }
</style>

{%- if section.settings.enable -%}
<div class="sc-rail" data-sc-rail>
  <div class="sc-rail__head">
    {%- if section.settings.heading != blank -%}<h3 class="sc-rail__title">{{ section.settings.heading }}</h3>{%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="sc-rail__viewall" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>

  {%- if tabs.size > 1 -%}
    <div class="sc-rail__tabs" role="tablist">
      {%- for tab in tabs -%}
        <button type="button" class="sc-rail__tab {% if forloop.first %}is-active{% endif %}" data-sc-tab="{{ forloop.index0 }}" {{ tab.shopify_attributes }}>
          {{ tab.settings.label | default: 'Tab' }}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if tabs.size > 0 -%}
    {%- for tab in tabs -%}
      {%- assign col = tab.settings.collection -%}
      <div class="sc-rail__panel {% if forloop.first %}is-active{% endif %}" data-sc-panel="{{ forloop.index0 }}">
        <div class="sc-rail__track">
          {%- if col != blank and col.products_count > 0 -%}
            {%- for product in col.products limit: section.settings.products_to_show -%}
              {%- render 'sc-product-card', product: product -%}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}{%- render 'sc-product-card' -%}{%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="sc-rail__panel is-active" data-sc-panel="0">
      <div class="sc-rail__track">
        {%- for i in (1..4) -%}{%- render 'sc-product-card' -%}{%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_arrows -%}
    <div class="sc-rail__arrows">
      <div class="sc-rail__rule"></div>
      <div class="sc-rail__arrowset">
        <button type="button" class="sc-rail__arrow sc-rail__arrow--prev" data-sc-arrow="-1" aria-label="Previous">←</button>
        <button type="button" class="sc-rail__arrow sc-rail__arrow--next" data-sc-arrow="1" aria-label="Next">→</button>
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root || root.dataset.scInit) return;
    root.dataset.scInit = '1';

    var tabBtns = root.querySelectorAll('[data-sc-tab]');
    var panels = root.querySelectorAll('[data-sc-panel]');
    tabBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var idx = btn.getAttribute('data-sc-tab');
        tabBtns.forEach(function (b) { b.classList.toggle('is-active', b === btn); });
        panels.forEach(function (p) { p.classList.toggle('is-active', p.getAttribute('data-sc-panel') === idx); });
      });
    });

    function activeTrack() {
      var panel = root.querySelector('.sc-rail__panel.is-active') || panels[0];
      return panel ? panel.querySelector('.sc-rail__track') : null;
    }
    root.querySelectorAll('[data-sc-arrow]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var el = activeTrack();
        if (el) el.scrollBy({ left: (+btn.getAttribute('data-sc-arrow')) * el.clientWidth * 0.85, behavior: 'smooth' });
      });
    });

    root.querySelectorAll('[data-sc-add-form]').forEach(function (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var btn = form.querySelector('.sc-pcard__add');
        var routes = (window.PXUTheme && window.PXUTheme.routes) || {};
        var addUrl = (routes.cart_add_url || '/cart/add') + '.js';
        var cartUrl = routes.cart_url || '/cart';
        if (btn) btn.classList.add('is-loading');
        fetch(addUrl, { method: 'POST', headers: { 'Accept': 'application/javascript', 'X-Requested-With': 'XMLHttpRequest' }, body: new FormData(form) })
          .then(function (r) { if (!r.ok) throw new Error('add failed'); return r.json(); })
          .then(function () {
            var drawer = (window.Core && window.Core.Components && window.Core.Components.getComponent) ? window.Core.Components.getComponent('cart-drawer') : null;
            if (drawer && drawer.data && drawer.data.enabled && typeof drawer.open === 'function') {
              try { drawer.open(btn, true, null); } catch (err) { window.location = cartUrl; }
            } else { window.location = cartUrl; }
          })
          .catch(function () { window.location = cartUrl; })
          .finally(function () { if (btn) btn.classList.remove('is-loading'); });
      });
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "SC Best sellers",
  "tag": "section",
  "class": "sc-section",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Enable section", "default": true },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Title", "default": "Best sellers" },
    { "type": "color", "id": "heading_color", "label": "Title colour", "default": "#1d1d1b" },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ] },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "header", "content": "Products" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 16, "step": 1, "label": "Products per tab", "default": 8 },
    { "type": "select", "id": "columns_desktop", "label": "Cards per row (desktop)", "default": "4", "options": [ { "value": "4", "label": "4" }, { "value": "6", "label": "6" } ] },
    { "type": "select", "id": "card_shape", "label": "Product image shape", "default": "portrait", "options": [ { "value": "portrait", "label": "Portrait (4:5)" }, { "value": "square", "label": "Square (1:1)" } ] },
    { "type": "checkbox", "id": "show_arrows", "label": "Show prev/next arrows (desktop)", "default": true },
    { "type": "header", "content": "Card accents" },
    { "type": "color", "id": "badge_color", "label": "Badge background", "default": "#b5e3d9" },
    { "type": "color", "id": "badge_text_color", "label": "Badge text", "default": "#1d1d1b" },
    { "type": "color", "id": "add_button_color", "label": "Add button", "default": "#1d1d1b" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 2, "unit": "px", "label": "Top padding (mobile)", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 2, "unit": "px", "label": "Bottom padding (mobile)", "default": 0 },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 240, "step": 2, "unit": "px", "label": "Top padding (desktop)", "default": 110 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 240, "step": 2, "unit": "px", "label": "Bottom padding (desktop)", "default": 0 },
    { "type": "paragraph", "content": "Each tab points at a collection. Add product badges/review counts via product metafields custom.badge and custom.review_count. Sale price shows automatically from the compare-at price." }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Best sellers" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SC Best sellers",
      "blocks": [
        { "type": "tab", "settings": { "label": "Best sellers" } },
        { "type": "tab", "settings": { "label": "New in" } },
        { "type": "tab", "settings": { "label": "Gifting" } },
        { "type": "tab", "settings": { "label": "Travel" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
