{% liquid
  assign heading = section.settings.heading | escape
  assign subheading = section.settings.subheading
  assign layout = section.settings.heading_position
  assign columns_per_row = section.settings.columns_per_row
  assign columns_per_row_mobile = section.settings.columns_per_row_mobile

  # Calculate column rows for 'inline' layout
  assign inline_columns = columns_per_row | minus: 1 | times: 1.0
  assign inline_rows = section.blocks.size | times: 1.0 | divided_by: inline_columns | ceil

  # Colors
  assign text_color = section.settings.color_text
  assign text_color_alpha = text_color | color_extract: 'alpha'
%}

<section
  data-component="multicolumn"
  data-component-type="section"
  {% if tag != blank %}data-component-tag="{{ tag }}"
  {% endif %}class="
    multicolumn
    multicolumn--{{ layout }}
    multicolumn--top-space-{{ section.settings.top_space }}
    multicolumn--bottom-space-{{ section.settings.bottom_space }}
    multicolumn--column-space-{{ section.settings.column_spacing }}
    multicolumn--column-align-{{ section.settings.column_alignment }}
    multicolumn--columns-per-row-desktop-{{ columns_per_row }}
    multicolumn--columns-per-row-mobile-{{ columns_per_row_mobile }}
  "
  style="
    {% if text_color_alpha != 0 %}
      --multicolumn-text-color: {{ text_color }};
    {% endif %}
    --multicolumn-background-color: {{ section.settings.color_background }};
    --multicolumn-rows: {{ inline_rows | default: 0 }};
    --multicolumn-desktop-columns: {{ columns_per_row }};
    --multicolumn-mobile-columns: {{ columns_per_row_mobile }};
    --multicolumn-image-aspect-ratio: {{ section.settings.image_aspect_ratio }};
  "
>
  <section-wrapper {% if section.settings.wide %}width="wide"{% endif %}>
    <div class="multicolumn__wrapper">
      <section-content class="multicolumn__grid">
        {% if heading != blank or subheading != blank %}
          <section-header class="multicolumn__header">
            <div class="multicolumn__header-wrapper">
              {% if heading != blank %}
                <h2 class="multicolumn__heading">
                  {{- heading -}}
                </h2>
              {% endif %}

              {% if subheading != blank %}
                <div class="multicolumn__subheading">
                  {{- subheading -}}
                </div>
              {% endif %}
            </div>
          </section-header>
        {% endif %}

        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% comment %}Component block-column:default begin{% endcomment %}
            {% liquid
              assign image = block.settings.image
              assign image_url = block.settings.image_url
              assign heading = block.settings.heading | escape
              assign content = block.settings.content
              assign button_label = block.settings.button_label | escape
            %}
            
            <div
              data-component="block-column"
              data-component-type="block"
              {% if tag != blank %}data-component-tag="{{ tag }}"
              {% endif %}class="block-column"
              style="--block-column-image-width: {{ block.settings.image_width }}%;"
              {{ block.shopify_attributes }}
            >
              <div class="block-column__wrapper">
                {% if image != blank %}
                  <div class="block-column__image">
                    <a class="block-column__image-link" {% if image_url != blank %}href="{{ image_url }}"{% endif %}>
                      {% comment %}Component lazy-img:default begin{% endcomment %}
                      {% render 'lazy-img', img: image, size: '2000x', lazy: true, canvas: true, focal_point: image.presentation.focal_point %}
                      {% comment %}Component lazy-img:default end{% endcomment %}
                    </a>
                  </div>
                {% endif %}
            
                {% if heading != blank %}
                  <h2
                    class="
                      block-column__heading
                      block-column__heading--size-{{ block.settings.heading_size }}
                    "
                  >
                    {{- heading -}}
                  </h2>
                {% endif %}
            
                {% if content != blank %}
                  <div
                    class="
                      block-column__content
                      block-column__content--size-{{ block.settings.content_size }}
                    "
                  >
                    {{- content -}}
                  </div>
                {% endif %}
            
                {% if button_label != blank %}
                  {% liquid
                    assign button_main_color = block.settings.color_main
                    assign button_main_color_alpha = button_main_color | color_extract: 'alpha'
                    assign button_contrast_color = block.settings.color_contrast
                    assign button_contrast_color_alpha = button_contrast_color | color_extract: 'alpha'
                    assign morph_base_color = button_main_color
                    assign morph_adjustment = 3
                  %}
            
                  {% capture color_button_morphed %}
                    {% comment %}Inject morph begin{% endcomment %}
                    {%- comment -%}
                      This adjusts the color to give it an appropriate difference from the original color.
                      It is usually used for link hover color, and things where we need to distinguish a change.
                    
                      @param morph_base_color {Color}
                        The origin color to morph
                    
                      @param morph_adjustment {Number}
                        The number to multiply the lightness and saturation by. Default 2.
                    {%- endcomment -%}
                    {%- liquid
                      if morph_adjustment == blank
                        assign morph_adjustment = 2
                      endif
                      assign morph_adjustment = morph_adjustment | times: 1.0
                      assign color_lightness = morph_base_color | color_extract: 'lightness'
                      if color_lightness > 20.0
                        if color_lightness > 50.0
                          assign light_adjustment = color_lightness | divided_by: 25.0 | times: morph_adjustment
                        else
                          assign light_adjustment = color_lightness | divided_by: 15.0 | times: morph_adjustment
                        endif
                        assign new_color = morph_base_color | color_darken: light_adjustment
                      else
                        if color_lightness < 7.0
                          assign light_adjustment = 3.0 | times: morph_adjustment
                          assign new_color = morph_base_color | color_desaturate: 45.0
                        elsif color_lightness < 12.0
                          assign light_adjustment = 2.25 | times: morph_adjustment
                          assign new_color = morph_base_color | color_desaturate: 15.0
                        else
                          assign light_adjustment = 1.75 | times: morph_adjustment
                          assign new_color = morph_base_color
                        endif
                        assign new_color = new_color | color_lighten: light_adjustment
                      endif
                    -%}
                    {{- new_color -}}
                    {%- liquid
                      assign morph_base_color = blank
                      assign morph_adjustment = blank
                    -%}
                    
                    {% comment %}Inject morph end{% endcomment %}
                  {% endcapture %}
            
                  <div
                    class="block-column__button"
                    style="
                      {% if button_main_color_alpha != 0 %}
                        --color-button-main: {{ button_main_color }};
                        --color-button-main-invoked: {{ color_button_morphed | strip }};
                      {% endif %}
                      {% if button_contrast_color_alpha != 0 %}
                        --color-button-main-contrast: {{ button_contrast_color }};
                      {% endif %}
                    "
                  >
                    {% comment %}Component button-link:default begin{% endcomment %}
                    {% liquid
                      assign href_809801bb = href
                      assign href = block.settings.button_url
                      assign text_809801bb = text
                      assign text = button_label
                      assign style_809801bb = style
                      assign style = block.settings.button_style
                      assign size_809801bb = size
                      assign size = 'medium'
                    %}
                    {% comment %}
                      @param href [Required]
                        This is the anchor tag for the link button.
                    
                      @param style [Required]
                        This is the style of the button: primary, secondary, tertiary, or text.
                    
                      @param size [Required]
                        This defines the size of the button: small, medium, or large.
                    
                      @param text [Required]
                        This is the text to be included in the button.
                    
                      @param attributes [Optional]
                        Any additional attributes to add to the button-link tag.
                    {% endcomment %}
                    
                    <a
                      data-component="button-link"
                      data-component-type="component"
                      {% if tag != blank %}data-component-tag="{{ tag }}"
                      {% endif %}class="button-link button-link--{{ style }} button-link--{{ size }}{% if style == 'primary' or style == 'secondary' %} button-link--shadow{% endif %%}"
                      {% if href != blank %}
                        href="{{ href }}"
                      {% endif %}
                      {{ attributes }}
                    >
                      {{ text }}
                    </a>
                    
                    {% liquid
                      assign href = href_809801bb
                      assign href_809801bb = nil
                      assign text = text_809801bb
                      assign text_809801bb = nil
                      assign style = style_809801bb
                      assign style_809801bb = nil
                      assign size = size_809801bb
                      assign size_809801bb = nil
                    %}
                    {% comment %}Component button-link:default end{% endcomment %}
                  </div>
                {% endif %}
              </div>
            </div>
            
            {% comment %}Component block-column:default end{% endcomment %}
          {% endfor %}
        {% endif %}
      </section-content>
    </div>
  </section-wrapper>
</section>
{% schema %}
{
  "name": "t:common.component.multicolumn",
  "settings": [
    {
      "type": "checkbox",
      "id": "wide",
      "label": "t:common.size.wide_display",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "top_space",
      "label": "t:common.layout.add_space_to_top",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_space",
      "label": "t:common.layout.add_space_to_bottom",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.text.heading",
      "default": "Multicolumn"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:common.text.subheading"
    },
    {
      "type": "select",
      "id": "heading_position",
      "label": "t:common.text.heading_position",
      "info": "t:component.multicolumn.heading_position.info",
      "options": [
        {
          "value": "left",
          "label": "t:common.layout.left"
        },
        {
          "value": "center",
          "label": "t:common.layout.center"
        },
        {
          "value": "inline",
          "label": "t:common.layout.inline"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "columns_per_row",
      "label": "t:component.multicolumn.columns_per_row.label",
      "step": 1,
      "min": 1,
      "max": 6,
      "default": 4
    },
    {
      "type": "select",
      "id": "column_alignment",
      "label": "t:component.multicolumn.column_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:common.layout.left"
        },
        {
          "value": "center",
          "label": "t:common.layout.center"
        },
        {
          "value": "right",
          "label": "t:common.layout.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "column_spacing",
      "label": "t:component.multicolumn.column_spacing.label",
      "info": "t:component.multicolumn.column_spacing.info",
      "options": [
        {
          "value": "small",
          "label": "t:common.size.small"
        },
        {
          "value": "medium",
          "label": "t:common.size.medium"
        },
        {
          "value": "large",
          "label": "t:common.size.large"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "t:common.image.image_aspect_ratio",
      "options": [
        {
          "value": "auto",
          "label": "t:common.size.natural"
        },
        {
          "value": "1/1",
          "label": "t:common.size.square_ratio_1_1"
        },
        {
          "value": "3/2",
          "label": "t:common.size.landscape_ratio_3_2"
        },
        {
          "value": "2/3",
          "label": "t:common.size.portrait_ratio_2_3"
        }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "t:common.layout.mobile"
    },
    {
      "type": "select",
      "id": "columns_per_row_mobile",
      "label": "t:component.multicolumn.columns_per_row_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:component.multicolumn.columns_per_row_mobile.option_1"
        },
        {
          "value": "2",
          "label": "t:component.multicolumn.columns_per_row_mobile.option_2"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "t:common.style.color"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:common.style.background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:common.text.text",
      "default": "transparent"
    }
  ],
  "presets": [
    {
      "name": "t:common.component.multicolumn",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "*"
    ]
  },
  "blocks": [
    {
      "type": "column",
      "name": "t:component.block_column.blocks.column.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:component.block_column.blocks.column.image.label"
        },
        {
          "type": "url",
          "id": "image_url",
          "label": "t:component.block_column.blocks.column.image_url.label"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 15,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "t:component.block_column.blocks.column.image_width.label",
          "default": 100
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:component.block_column.blocks.column.heading.label",
          "default": "Column"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "t:component.block_column.blocks.column.heading_size.label",
          "options": [
            {
              "value": "small",
              "label": "t:component.block_column.blocks.column.heading_size.option_1"
            },
            {
              "value": "medium",
              "label": "t:component.block_column.blocks.column.heading_size.option_2"
            },
            {
              "value": "large",
              "label": "t:component.block_column.blocks.column.heading_size.option_3"
            }
          ],
          "default": "small"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:component.block_column.blocks.column.content.label",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post.</p>"
        },
        {
          "type": "select",
          "id": "content_size",
          "label": "t:component.block_column.blocks.column.content_size.label",
          "options": [
            {
              "value": "small",
              "label": "t:component.block_column.blocks.column.content_size.option_1"
            },
            {
              "value": "medium",
              "label": "t:component.block_column.blocks.column.content_size.option_2"
            },
            {
              "value": "large",
              "label": "t:component.block_column.blocks.column.content_size.option_3"
            }
          ],
          "default": "medium"
        },
        {
          "type": "header",
          "content": "t:component.block_column.blocks.column.header_1.content"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:component.block_column.blocks.column.button_label.label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "t:component.block_column.blocks.column.button_url.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "t:component.block_column.blocks.column.button_style.label",
          "options": [
            {
              "value": "primary",
              "label": "t:component.block_column.blocks.column.button_style.option_1"
            },
            {
              "value": "secondary",
              "label": "t:component.block_column.blocks.column.button_style.option_2"
            },
            {
              "value": "icon",
              "label": "t:component.block_column.blocks.column.button_style.option_3"
            },
            {
              "value": "text",
              "label": "t:component.block_column.blocks.column.button_style.option_4"
            }
          ],
          "default": "primary"
        },
        {
          "type": "color",
          "id": "color_main",
          "label": "t:component.block_column.blocks.column.color_main.label",
          "default": "transparent"
        },
        {
          "type": "color",
          "id": "color_contrast",
          "label": "t:component.block_column.blocks.column.color_contrast.label",
          "default": "transparent"
        }
      ]
    }
  ]
}
{% endschema %}