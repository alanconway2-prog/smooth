{% comment %}
  Smooth Company — "As seen in" press band (custom)
  One airy centred band on white. Press entries are merchant-uploadable logo
  IMAGES with a Gotham Bold text fallback when no image is set. The single press
  touchpoint on the homepage — keep proof off the rest of the page.
{% endcomment %}
<style>
  #shopify-section-{{ section.id }} .sc-press {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    text-align: center; background: {{ section.settings.background_color }};
  }
  #shopify-section-{{ section.id }} .sc-press__eyebrow {
    font-family: 'Gotham Medium', sans-serif; font-size: 11px; letter-spacing: 0.24em;
    text-transform: uppercase; color: {{ section.settings.eyebrow_color }};
    margin: 0 0 18px;
  }
  #shopify-section-{{ section.id }} .sc-press__names {
    display: flex; align-items: center; justify-content: center; flex-wrap: wrap;
    gap: 20px;
  }
  #shopify-section-{{ section.id }} .sc-press__entry {
    display: inline-flex; align-items: center; text-decoration: none;
    color: #1d1d1b; font-family: 'Gotham', sans-serif; font-weight: 700;
    text-transform: none; font-size: 17px; line-height: 1; letter-spacing: -0.01em;
  }
  #shopify-section-{{ section.id }} .sc-press__logo {
    height: 20px; width: auto; object-fit: contain; opacity: 0.85; display: block;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .sc-press {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      padding-left: 48px; padding-right: 48px;
    }
    #shopify-section-{{ section.id }} .sc-press__eyebrow { margin-bottom: 24px; }
    #shopify-section-{{ section.id }} .sc-press__names { gap: 52px; }
    #shopify-section-{{ section.id }} .sc-press__entry { font-size: 26px; }
    #shopify-section-{{ section.id }} .sc-press__logo { height: {{ section.settings.logo_height }}px; }
  }
</style>
{%- if section.settings.enable -%}
  <div class="sc-press">
    {%- if section.settings.eyebrow != blank -%}
      <p class="sc-press__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <div class="sc-press__names">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign press_name = block.settings.name -%}
          {%- if block.settings.url != blank -%}
            <a class="sc-press__entry" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {%- assign press_alt = press_name | default: shop.name -%}
                {{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: press_alt, class: 'sc-press__logo' }}
              {%- else -%}
                {{ press_name }}
              {%- endif -%}
            </a>
          {%- else -%}
            <span class="sc-press__entry" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {%- assign press_alt = press_name | default: shop.name -%}
                {{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: press_alt, class: 'sc-press__logo' }}
              {%- else -%}
                {{ press_name }}
              {%- endif -%}
            </span>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <span class="sc-press__entry">Vogue</span>
        <span class="sc-press__entry">Good Morning America</span>
        <span class="sc-press__entry">GQ</span>
        <span class="sc-press__entry">YOU</span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "SC Press band",
  "tag": "section",
  "class": "sc-section",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Enable section", "default": true },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "As seen in" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow colour", "default": "#1d1d1b" },
    { "type": "range", "id": "logo_height", "min": 16, "max": 48, "step": 2, "unit": "px", "label": "Logo height (desktop)", "default": 26 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 2, "unit": "px", "label": "Top padding (mobile)", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 2, "unit": "px", "label": "Bottom padding (mobile)", "default": 0 },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 200, "step": 2, "unit": "px", "label": "Top padding (desktop)", "default": 110 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 200, "step": 2, "unit": "px", "label": "Bottom padding (desktop)", "default": 0 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo image (overrides name)" },
        { "type": "text", "id": "name", "label": "Name (fallback)", "default": "Vogue" },
        { "type": "url", "id": "url", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SC Press band",
      "blocks": [
        { "type": "logo", "settings": { "name": "Vogue" } },
        { "type": "logo", "settings": { "name": "Good Morning America" } },
        { "type": "logo", "settings": { "name": "GQ" } },
        { "type": "logo", "settings": { "name": "YOU" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
