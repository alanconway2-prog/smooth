{% comment %}
  Smooth Company — Shop by category (custom)
  Big left title + "View all" link (secHead), then full-bleed edge-to-edge tiles
  with 2px gaps. Category name bottom-left in bold Gotham over a soft bottom
  gradient. Each tile links to a collection (or block override) with placeholder.
{% endcomment %}
<style>
  #shopify-section-{{ section.id }} .sc-cat {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }
  #shopify-section-{{ section.id }} .sc-cat__head {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 20px;
    padding: 0 20px 24px;
    text-align: {{ section.settings.heading_alignment }};
  }
  #shopify-section-{{ section.id }} .sc-cat__title {
    font-family: 'Gotham', sans-serif; font-weight: 700; text-transform: none;
    font-size: 25px; letter-spacing: -0.02em; line-height: 1; margin: 0;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .sc-cat__viewall {
    font-family: 'Gotham Medium', sans-serif; font-size: 11px; letter-spacing: 0.2em;
    text-transform: uppercase; color: #1d1d1b; text-decoration: none;
    border-bottom: 1px solid #1d1d1b; padding-bottom: 3px; flex: 0 0 auto;
  }
  {%- if section.settings.heading_alignment == 'center' -%}
    #shopify-section-{{ section.id }} .sc-cat__head { justify-content: center; flex-direction: column; align-items: center; gap: 14px; }
  {%- elsif section.settings.heading_alignment == 'right' -%}
    #shopify-section-{{ section.id }} .sc-cat__head { flex-direction: row-reverse; }
  {%- endif -%}
  #shopify-section-{{ section.id }} .sc-cat__grid {
    display: flex; flex-direction: column; gap: 2px;
  }
  #shopify-section-{{ section.id }} .sc-cat__tile {
    position: relative; overflow: hidden; display: block; text-decoration: none;
    height: 300px;
  }
  #shopify-section-{{ section.id }} .sc-cat__media {
    position: absolute; inset: 0;
    background: repeating-linear-gradient(120deg,#e8ded4 0 18px,#f0e8de 18px 36px);
  }
  #shopify-section-{{ section.id }} .sc-cat__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .sc-cat__grad {
    position: absolute; left: 0; right: 0; bottom: 0; top: 0; z-index: 1;
    background: linear-gradient(to top, rgba(20,18,15,0.36), transparent 50%);
  }
  #shopify-section-{{ section.id }} .sc-cat__label {
    position: absolute; z-index: 2; bottom: 22px; left: 22px; color: #fff;
    font-family: 'Gotham', sans-serif; font-weight: 700; text-transform: none;
    font-size: 20px; letter-spacing: -0.01em; line-height: 1;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .sc-cat {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
    #shopify-section-{{ section.id }} .sc-cat__head { padding: 0 48px 34px; }
    #shopify-section-{{ section.id }} .sc-cat__title { font-size: 34px; }
    #shopify-section-{{ section.id }} .sc-cat__grid {
      display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); gap: 2px;
    }
    #shopify-section-{{ section.id }} .sc-cat__tile { height: auto; aspect-ratio: 3/4; }
    #shopify-section-{{ section.id }} .sc-cat__label { bottom: 26px; left: 26px; font-size: 26px; }
  }
</style>
{%- if section.settings.enable -%}
  <div class="sc-cat">
    <div class="sc-cat__head">
      <h3 class="sc-cat__title">{{ section.settings.heading }}</h3>
      {%- if section.settings.link_label != blank -%}
        <a class="sc-cat__viewall" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    <div class="sc-cat__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign col = block.settings.collection -%}
          {%- assign label = block.settings.label | default: col.title -%}
          {%- assign img = block.settings.image | default: col.featured_image -%}
          {%- assign link = block.settings.url | default: col.url -%}
          <a class="sc-cat__tile" href="{{ link | default: '#' }}" {{ block.shopify_attributes }}>
            <span class="sc-cat__media">
              {%- if img != blank -%}
                {%- assign tile_alt = label | default: shop.name -%}
                {{ img | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width:1024px) 33vw, 100vw', widths: '450, 600, 900, 1200', alt: tile_alt }}
              {%- endif -%}
            </span>
            <span class="sc-cat__grad"></span>
            <span class="sc-cat__label">{{ label }}</span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- assign ph = 'Brushes,Sticks,Gifting' | split: ',' -%}
        {%- for name in ph -%}
          <a class="sc-cat__tile" href="#">
            <span class="sc-cat__media"></span>
            <span class="sc-cat__grad"></span>
            <span class="sc-cat__label">{{ name }}</span>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "SC Category rail",
  "tag": "section",
  "class": "sc-section",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Enable section", "default": true },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "#1d1d1b" },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ], "default": "left" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Columns (desktop)", "default": 3 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 2, "unit": "px", "label": "Top padding (mobile)", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 2, "unit": "px", "label": "Bottom padding (mobile)", "default": 0 },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 240, "step": 2, "unit": "px", "label": "Top padding (desktop)", "default": 110 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 240, "step": 2, "unit": "px", "label": "Bottom padding (desktop)", "default": 0 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label (overrides collection title)" },
        { "type": "image_picker", "id": "image", "label": "Image (overrides collection image)" },
        { "type": "url", "id": "url", "label": "Link (overrides collection URL)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SC Category rail",
      "blocks": [
        { "type": "category", "settings": { "label": "Brushes" } },
        { "type": "category", "settings": { "label": "Sticks" } },
        { "type": "category", "settings": { "label": "Gifting" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
