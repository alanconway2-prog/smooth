{%- assign s = section.settings -%}
{%- assign label = s.st_label | strip -%}
{%- assign lead = s.st_lead | strip -%}
{%- assign close = s.st_close | strip -%}
{%- assign quote = s.st_quote | strip -%}
{%- assign qname = s.st_name | strip -%}
{%- assign qrole = s.st_role | strip -%}
{%- assign alt_photo = s.st_image.alt | default: qname | default: 'Founder portrait' -%}

<style>
  .wlm-content .shopify-section,
  #site-main .shopify-section { margin: 0 !important; padding: 0 !important; }
  wlm.wlm-content { display: contents; }
  #site-main .shopify-section > section { margin: 0 !important; }
  #site-main { gap: 0 !important; row-gap: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
  .wlm-content { gap: 0 !important; }

  #scst-{{ section.id }} {
    background-color: {{ s.st_bg }};
    color: {{ s.st_ink }};
    padding: {{ s.st_pad_m }}px 20px;
  }

  #scst-{{ section.id }} .scst__inner {
    max-width: {{ s.st_max }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ s.st_gap_m }}px;
  }

  #scst-{{ section.id }} .scst__inner,
  #scst-{{ section.id }} .scst__inner * {
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    animation: none !important;
    clip-path: none !important;
  }

  /* Left: standards */
  #scst-{{ section.id }} .scst__label {
    margin: 0 0 14px;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.6 !important;
  }
  #scst-{{ section.id }} .scst__lead {
    margin: 0 0 {{ s.st_gap_lead }}px;
    font-size: {{ s.st_lead_size_m }}px;
    line-height: 1.5;
    max-width: 34ch;
  }
  #scst-{{ section.id }} .scst__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ s.st_grid_gap_m }}px;
  }
  #scst-{{ section.id }} .scst__item-icon {
    display: block;
    width: {{ s.st_icon_size }}px;
    height: {{ s.st_icon_size }}px;
    margin-bottom: 10px;
    color: {{ s.st_ink }};
  }
  #scst-{{ section.id }} .scst__item-icon svg { width: 100%; height: 100%; display: block; }
  #scst-{{ section.id }} .scst__item-label {
    margin: 0;
    font-size: {{ s.st_item_size_m }}px;
    line-height: 1.25;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 500;
  }
  #scst-{{ section.id }} .scst__close {
    margin: {{ s.st_gap_close }}px 0 0;
    font-size: {{ s.st_close_size_m }}px;
    line-height: 1.5;
    max-width: 32ch;
  }

  /* Middle: photo */
  #scst-{{ section.id }} .scst__media {
    width: 100%;
    aspect-ratio: {{ s.st_ratio_m }};
    overflow: hidden;
    background-color: {{ s.st_placeholder }};
  }
  #scst-{{ section.id }} .scst__media img,
  #scst-{{ section.id }} .scst__media svg {
    width: 100%; height: 100%; object-fit: cover; object-position: {{ s.st_focal }}; display: block;
  }

  /* Right: quote */
  #scst-{{ section.id }} .scst__quote {
    margin: 0;
    padding: 0;
    font-size: {{ s.st_quote_size_m }}px;
    line-height: 1.55;
    font-weight: 400;
    font-style: italic;
    letter-spacing: 0;
  }
  #scst-{{ section.id }} .scst__attr {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid currentColor;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  #scst-{{ section.id }} .scst__name { font-size: 13px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; }
  #scst-{{ section.id }} .scst__role { font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.6; }

  /* Desktop: three columns, standards | photo | quote */
  @media screen and (min-width: 900px) {
    #scst-{{ section.id }} {
      padding: {{ s.st_pad_d }}px 48px;
    }
    #scst-{{ section.id }} .scst__inner {
      grid-template-columns: {{ s.st_col_standards }}fr {{ s.st_col_photo }}fr {{ s.st_col_quote }}fr;
      gap: {{ s.st_gap_d }}px;
      align-items: start;
    }
    #scst-{{ section.id }} .scst__lead { font-size: {{ s.st_lead_size_d }}px; }
    #scst-{{ section.id }} .scst__grid { gap: {{ s.st_grid_gap_d }}px; }
    #scst-{{ section.id }} .scst__item-label { font-size: {{ s.st_item_size_d }}px; }
    #scst-{{ section.id }} .scst__close { font-size: {{ s.st_close_size_d }}px; }
    #scst-{{ section.id }} .scst__media { aspect-ratio: {{ s.st_ratio_d }}; }
    #scst-{{ section.id }} .scst__quote { font-size: {{ s.st_quote_size_d }}px; }
  }
</style>

<section id="scst-{{ section.id }}" class="scst" {{ section.shopify_attributes }}>
  <div class="scst__inner">

    <div class="scst__standards">
      {%- if label != blank -%}<p class="scst__label">{{ label }}</p>{%- endif -%}
      {%- if lead != blank -%}<p class="scst__lead">{{ lead }}</p>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="scst__grid">
          {%- for block in section.blocks -%}
            {%- assign w = block.settings.sti_label | strip -%}
            <div class="scst__item" {{ block.shopify_attributes }}>
              {%- case block.settings.sti_icon -%}
                {%- when 'people' -%}
                  <span class="scst__item-icon"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="18" cy="17" r="6"/><circle cx="32" cy="19" r="5"/><path d="M8 38c0-6 5-10 10-10s10 4 10 10M28 30c1-2 4-4 7-4 5 0 8 4 8 9"/></svg></span>
                {%- when 'leaf' -%}
                  <span class="scst__item-icon"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 36C12 20 24 10 38 10c0 16-12 26-26 26ZM12 36c6-8 12-13 20-17"/></svg></span>
                {%- when 'doc' -%}
                  <span class="scst__item-icon"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 6h16l8 8v28H13Z"/><path d="M29 6v8h8M19 24h12M19 31h12"/></svg></span>
                {%- when 'shield' -%}
                  <span class="scst__item-icon"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M24 5 40 11v11c0 11-7 18-16 21-9-3-16-10-16-21V11Z"/><path d="M17 24l5 5 9-10"/></svg></span>
              {%- endcase -%}
              {%- if w != blank -%}<p class="scst__item-label">{{ w }}</p>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if close != blank -%}<p class="scst__close">{{ close }}</p>{%- endif -%}
    </div>

    <div class="scst__media">
      {%- if s.st_image != blank -%}
        {{ s.st_image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 30vw, 100vw', widths: '400, 600, 800, 1000', alt: alt_photo }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    <div class="scst__quotewrap">
      {%- if quote != blank -%}<p class="scst__quote">{{ quote }}</p>{%- endif -%}
      {%- if qname != blank -%}
        <div class="scst__attr">
          <span class="scst__name">{{ qname }}</span>
          {%- if qrole != blank -%}<span class="scst__role">{{ qrole }}</span>{%- endif -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "B Corp: Standards",
  "tag": "section",
  "class": "scst-section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Standards column" },
    { "type": "text", "id": "st_label", "label": "Label", "default": "Why B Corp matters" },
    { "type": "textarea", "id": "st_lead", "label": "Lead line", "default": "B Corp Certification means we meet the highest standards of" },
    { "type": "text", "id": "st_close", "label": "Closing line", "default": "A higher standard of business, the Smooth way." },
    { "type": "header", "content": "Photo column" },
    { "type": "image_picker", "id": "st_image", "label": "Founder photo" },
    { "type": "select", "id": "st_focal", "label": "Photo focal point", "options": [ { "value": "left center", "label": "Left" }, { "value": "center center", "label": "Centre" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" } ], "default": "center center" },
    { "type": "select", "id": "st_ratio_d", "label": "Photo ratio, desktop", "options": [ { "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait 4:5" }, { "value": "3 / 4", "label": "Portrait 3:4" } ], "default": "4 / 5" },
    { "type": "select", "id": "st_ratio_m", "label": "Photo ratio, mobile", "options": [ { "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait 4:5" }, { "value": "4 / 3", "label": "Landscape 4:3" } ], "default": "4 / 3" },
    { "type": "color", "id": "st_placeholder", "label": "Placeholder colour", "default": "#9ed3c4" },
    { "type": "header", "content": "Quote column" },
    { "type": "textarea", "id": "st_quote", "label": "Quote", "default": "The Smooth Company was never just about creating products people love. It was about building a business that could make a positive impact." },
    { "type": "text", "id": "st_name", "label": "Name", "default": "Áine Kennedy" },
    { "type": "text", "id": "st_role", "label": "Role", "default": "Founder and CEO" },
    { "type": "header", "content": "Column widths, desktop" },
    { "type": "range", "id": "st_col_standards", "label": "Standards column", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "st_col_photo", "label": "Photo column", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "range", "id": "st_col_quote", "label": "Quote column", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "st_icon_size", "label": "Standard icon size", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "st_gap_d", "label": "Gap between columns, desktop", "min": 24, "max": 96, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "st_gap_m", "label": "Gap between blocks, mobile", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "st_grid_gap_d", "label": "Gap between standards, desktop", "min": 12, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "st_grid_gap_m", "label": "Gap between standards, mobile", "min": 12, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "st_gap_lead", "label": "Gap under lead line", "min": 12, "max": 56, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "st_gap_close", "label": "Gap above closing line", "min": 16, "max": 56, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "st_pad_d", "label": "Section padding, desktop", "min": 40, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "st_pad_m", "label": "Section padding, mobile", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "st_max", "label": "Content max width", "min": 900, "max": 1400, "step": 20, "unit": "px", "default": 1200 },
    { "type": "header", "content": "Colour and type" },
    { "type": "color", "id": "st_bg", "label": "Background", "default": "#b5e3d9" },
    { "type": "color", "id": "st_ink", "label": "Text", "default": "#1d1d1b" },
    { "type": "range", "id": "st_lead_size_d", "label": "Lead size, desktop", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "st_lead_size_m", "label": "Lead size, mobile", "min": 13, "max": 18, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "st_item_size_d", "label": "Standard label size, desktop", "min": 11, "max": 16, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "st_item_size_m", "label": "Standard label size, mobile", "min": 11, "max": 15, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "st_close_size_d", "label": "Closing size, desktop", "min": 13, "max": 20, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "st_close_size_m", "label": "Closing size, mobile", "min": 12, "max": 18, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "st_quote_size_d", "label": "Quote size, desktop", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "st_quote_size_m", "label": "Quote size, mobile", "min": 14, "max": 22, "step": 1, "unit": "px", "default": 16 }
  ],
  "blocks": [
    {
      "type": "standard",
      "name": "Standard",
      "settings": [
        { "type": "select", "id": "sti_icon", "label": "Icon", "options": [ { "value": "none", "label": "None" }, { "value": "people", "label": "People" }, { "value": "leaf", "label": "Leaf" }, { "value": "doc", "label": "Document" }, { "value": "shield", "label": "Shield" } ], "default": "none" },
        { "type": "text", "id": "sti_label", "label": "Standard" }
      ]
    }
  ],
  "presets": [
    {
      "name": "B Corp: Standards",
      "blocks": [
        { "type": "standard", "settings": { "sti_icon": "people", "sti_label": "Social impact" } },
        { "type": "standard", "settings": { "sti_icon": "leaf", "sti_label": "Environmental responsibility" } },
        { "type": "standard", "settings": { "sti_icon": "doc", "sti_label": "Transparency" } },
        { "type": "standard", "settings": { "sti_icon": "shield", "sti_label": "Accountability" } }
      ]
    }
  ]
}
{% endschema %}
