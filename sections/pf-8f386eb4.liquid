    {
      "type": "html",
      "id": "pf_465a44fb_value",
      "label": "Paragraph4 — Value",
      "default": "<strong>2025:&nbsp;</strong>Marie Claire Awards, Best Smoothing and Anti-Frizz Tool: Mane Master.&nbsp;<br><strong>2025: </strong>Women &amp; Home Awards, Best for Flyaways: Smooth Stick&nbsp;<br><strong>2025: </strong>VIP Awards Best Irish Beuty Brand&nbsp;<br><strong>2024: </strong>Image Business of Beauty Awards, Irish Haircare Brand<br><strong>2024: </strong>Marie Claire Awards, Highly Commended in Best New Hair Tool: 4-in-one Smooth Styler<br><strong>2022: </strong>Hi Style Awards, Best New Product: Smooth Stick<br><br><strong>CEO Aine's Awards:&nbsp;<br>2025:</strong> EY Emerging Entrepreneur of the&nbsp;Year&nbsp;<br><strong>2024: </strong>Image Bussiness Woman of the Year, Young Entrepreneur of the Year<br><strong>2023:</strong> Irish Wwomen's Awards, Young Entrepreneur of the Year"
    },
