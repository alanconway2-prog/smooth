<section data-component="customer-addresses" data-component-type="section" {% if tag != blank %}data-component-tag="{{ tag }}" {% endif %}class="customer-addresses">
  <section-wrapper width="constrained">
    <section-header class="customer-addresses__header">
      <a href="{{ routes.account_url }}" class="customer-addresses__back">&larr; {{ 'general.customer.return' | t }}</a>

      <h1 class="customer-addresses__heading">{{ 'customer.addresses.title' | t }}</h1>
    </section-header>
  </section-wrapper>
  <section-wrapper width="constrained">
    <section-content>
    {%- paginate customer.addresses by 5 -%}
      <div class="customer-addresses__new-address" data-address-item>
        {% comment %}Component customer-address-form:default begin{% endcomment %}
        {% comment %}
          @param address
            The address to be edited. If blank, it will generate a new address.
        
          @param index
            The index of the address in a list of addresses.
        
        {% endcomment %}
        
        {% assign new_text = 'customer.addresses.add_new' | t  %}
        {% assign edit_text = 'customer.addresses.edit' | t %}
        {% assign delete_text = 'customer.addresses.delete' | t %}
        {% assign create_new_address = false %}
        {% unless address %}
          {% assign create_new_address = true %}
        {% endunless %}
        {% assign address = address | default: customer.new_address %}
        
        <div data-component="customer-address-form" data-component-type="component" {% if tag != blank %}data-component-tag="{{ tag }}" {% endif %}class="customer-address-form">
          {% capture edit_attributes %}
            aria-label="{{ edit_text }} {{ index }}" aria-expanded="false" aria-controls="edit-address-{{ address.id }}"
          {% endcapture %}
        
          {% capture delete_attributes %}
            aria-label="{{ delete_text }} {{ index }}"
            data-target="{{ address.url }}"
            data-confirm-message="{{ 'customer.addresses.delete_confirm' | t }}"
          {% endcapture %}
        
          {% if create_new_address %}
            {% comment %}Component button:default begin{% endcomment %}
            {% liquid
              assign tag_b69eb9ed = tag
              assign tag = 'edit-address'
              assign style_b69eb9ed = style
              assign style = 'secondary'
              assign size_b69eb9ed = size
              assign size = 'small'
              assign text_b69eb9ed = text
              assign text = new_text
              assign attributes_b69eb9ed = attributes
              assign attributes = 'aria-expanded="false" aria-controls="new-address"'
            %}
            {% comment %}
              @param style [Required]
                This is the style of the button: primary, secondary, tertiary, or text. Default primary.
            
              @param size [Required]
                This defines the size of the button: small, medium, or large. Default medium.
            
              @param text [Required]
                This is the text to be included in the button.
            
              @param attributes [Optional]
                This will include any additional attributes that the button needs. For example, aria-controls.
            {% endcomment %}
            
            <button
              data-component="button"
              data-component-type="component"
              {% if tag != blank %}data-component-tag="{{ tag }}"
              {% endif %}class="button button--{{ style }} button--{{ size }}{% if style == 'primary' or style == 'secondary' %} button--shadow{% endif %%}"
              {{ attributes }}
            >
              {{ text }}
            </button>
            
            {% liquid
              assign tag = tag_b69eb9ed
              assign tag_b69eb9ed = nil
              assign style = style_b69eb9ed
              assign style_b69eb9ed = nil
              assign size = size_b69eb9ed
              assign size_b69eb9ed = nil
              assign text = text_b69eb9ed
              assign text_b69eb9ed = nil
              assign attributes = attributes_b69eb9ed
              assign attributes_b69eb9ed = nil
            %}
            {% comment %}Component button:default end{% endcomment %}
          {% else %}
            {% comment %}Component customer-address:default begin{% endcomment %}
            {% comment %}
              @param address
                The address to be displayed.
            {% endcomment %}
            
            <div data-component="customer-address" data-component-type="component" {% if tag != blank %}data-component-tag="{{ tag }}" {% endif %}class="customer-address">
