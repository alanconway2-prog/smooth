{% comment %}
  Smooth Company — Reviews (custom / PROVISIONAL — Touchpoint 3)
  Big centered statement + a grid (desktop) / horizontal rail (mobile) of mint
  review cards. Each card = mint background, black stars, quote, verified name.

  PROVISIONAL: the card markup is kept deliberately generic and swappable. Once a
  reviews platform is chosen (Loox / Klaviyo Reviews / Firework), replace the
  blocks loop (or the whole grid) with that app's block/snippet. Heading + CTA stay.
{% endcomment %}
{%- if section.settings.enable -%}
<style>
  #shopify-section-{{ section.id }} .sc-rev {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }
  #shopify-section-{{ section.id }} .sc-rev__head {
    text-align: {{ section.settings.heading_alignment }};
    padding: 0 24px; margin-bottom: 28px;
  }
  #shopify-section-{{ section.id }} .sc-rev__heading {
    font-family: 'Gotham', sans-serif; font-weight: 700; text-transform: none;
    font-size: 30px; line-height: 1.05; letter-spacing: -0.02em; margin: 0;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .sc-rev__grid {
    display: flex; gap: 2px; overflow-x: auto; padding: 0 20px;
    scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
  }
  #shopify-section-{{ section.id }} .sc-rev__grid::-webkit-scrollbar { height: 0; }
  #shopify-section-{{ section.id }} .sc-rev__card {
    flex: 0 0 240px; scroll-snap-align: start;
    background: {{ section.settings.card_color }}; color: #000; padding: 20px;
  }
  #shopify-section-{{ section.id }} .sc-rev__media {
    aspect-ratio: 1/1; margin-bottom: 14px; overflow: hidden;
    background: repeating-linear-gradient(120deg,#eef0ee 0 13px,#f6f7f5 13px 26px);
  }
  #shopify-section-{{ section.id }} .sc-rev__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .sc-rev__chip {
    display: inline-block; background: #1d1d1b; color: #fff; margin-bottom: 12px;
    padding: 5px 9px; font-family: 'Gotham Medium', sans-serif;
    font-size: 8.5px; letter-spacing: 0.16em; text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .sc-rev__stars {
    font-size: 12px; letter-spacing: 0.1em; margin-bottom: 12px; color: #1d1d1b;
  }
  #shopify-section-{{ section.id }} .sc-rev__quote {
    font-family: 'Gotham Medium', sans-serif; font-size: 14px; line-height: 1.42;
    margin: 0 0 14px; color: #1d1d1b;
  }
  #shopify-section-{{ section.id }} .sc-rev__lab {
    font-family: 'Gotham Medium', sans-serif; font-size: 9px; letter-spacing: 0.2em;
    text-transform: uppercase; color: #1d1d1b;
  }
  #shopify-section-{{ section.id }} .sc-rev__cta { text-align: center; margin-top: 26px; padding: 0 20px; }
  #shopify-section-{{ section.id }} .sc-rev__btn {
    display: inline-block; border: 1px solid #1d1d1b; border-radius: 0; background: transparent; color: #1d1d1b;
    font-family: 'Gotham Medium', sans-serif; font-size: 11px; letter-spacing: 0.16em;
    text-transform: uppercase; padding: 14px 34px; transition: all .18s;
  }
  #shopify-section-{{ section.id }} .sc-rev__btn:hover { background: #1d1d1b; color: #fff; }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .sc-rev {
      padding: {{ section.settings.padding_top_desktop }}px 48px {{ section.settings.padding_bottom_desktop }}px;
    }
    #shopify-section-{{ section.id }} .sc-rev__head { margin-bottom: 40px; }
    #shopify-section-{{ section.id }} .sc-rev__heading { font-size: 52px; }
    #shopify-section-{{ section.id }} .sc-rev__grid {
      display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      gap: 2px; overflow: visible; padding: 0;
    }
    #shopify-section-{{ section.id }} .sc-rev__card { flex: none; scroll-snap-align: none; padding: 28px; }
    #shopify-section-{{ section.id }} .sc-rev__quote { font-size: 15px; }
    #shopify-section-{{ section.id }} .sc-rev__cta { margin-top: 38px; padding: 0; }
  }
</style>
<div class="sc-rev">
  {%- if section.settings.heading != blank -%}
    <div class="sc-rev__head">
      <h2 class="sc-rev__heading">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}
  <div class="sc-rev__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign alt_txt = block.settings.name | default: 'Verified review' -%}
        <div class="sc-rev__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="sc-rev__media">
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '240px', widths: '240, 360, 480, 600', alt: alt_txt }}
            </div>
          {%- endif -%}
          {%- if block.settings.product != blank -%}<span class="sc-rev__chip">{{ block.settings.product }}</span>{%- endif -%}
          <div class="sc-rev__stars">★★★★★</div>
          {%- if block.settings.quote != blank -%}<p class="sc-rev__quote">“{{ block.settings.quote }}”</p>{%- endif -%}
          <div class="sc-rev__lab">{{ block.settings.name }} · Verified</div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
  {%- if section.settings.button_label != blank -%}
    <div class="sc-rev__cta">
      <a class="sc-rev__btn" href="{{ section.settings.button_url | default: '#' }}">{{ section.settings.button_label }}</a>
    </div>
  {%- endif -%}
</div>
{%- endif -%}
{% schema %}
{
  "name": "SC Reviews",
  "tag": "section",
  "class": "sc-section",
  "settings": [
    { "type": "paragraph", "content": "Provisional — swap for your reviews app once chosen." },
    { "type": "checkbox", "id": "enable", "label": "Enable section", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "460+ five-star reviews." },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1d1d1b" },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ], "default": "center" },
    { "type": "header", "content": "Cards" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#b5e3d9" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns (desktop)", "default": 4 },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 2, "unit": "px", "label": "Top padding (mobile)", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 2, "unit": "px", "label": "Bottom padding (mobile)", "default": 0 },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 240, "step": 2, "unit": "px", "label": "Top padding (desktop)", "default": 110 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 240, "step": 2, "unit": "px", "label": "Bottom padding (desktop)", "default": 0 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo (optional)" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "My hair has never looked so polished." },
        { "type": "text", "id": "name", "label": "Name", "default": "Amara K." },
        { "type": "text", "id": "product", "label": "Product chip label (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SC Reviews",
      "blocks": [
        { "type": "review", "settings": { "quote": "My hair has never looked so polished.", "name": "Amara K." } },
        { "type": "review", "settings": { "quote": "The stick lives in my bag now.", "name": "Priya S." } },
        { "type": "review", "settings": { "quote": "Frizz gone in seconds, no crunch.", "name": "Jo M." } },
        { "type": "review", "settings": { "quote": "Feels like skincare for my hair.", "name": "Elle R." } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
