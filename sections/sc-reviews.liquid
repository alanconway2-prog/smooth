{% comment %}
  Smooth Company — Reviews (custom / PROVISIONAL — Touchpoint 3)
  Big aggregate score, full stars, "460+ verified reviews", a rail of photo review
  cards (image + stars + quote + verified buyer + product), and an outline CTA.

  PROVISIONAL: markup is kept deliberately generic and swappable. Once the reviews
  platform is chosen (Loox / Klaviyo Reviews / Firework), replace the cards loop
  (or the whole rail) with that app's block/snippet. The header + CTA can stay.
{% endcomment %}
<style>
  #shopify-section-{{ section.id }} .sc-rev { padding: {{ section.settings.padding_top }}px 0 0; background: {{ section.settings.background_color }}; }
  #shopify-section-{{ section.id }} .sc-rev__head { text-align: center; margin-bottom: 30px; }
  #shopify-section-{{ section.id }} .sc-rev__score {
    font-family: 'Gotham', 'Gotham Medium', sans-serif; font-weight: 700; font-size: 72px; line-height: 0.9; color: #1d1d1b;
  }
  #shopify-section-{{ section.id }} .sc-rev__stars { font-size: 15px; letter-spacing: 0.14em; margin: 10px 0 8px; color: #000; }
  #shopify-section-{{ section.id }} .sc-rev__count {
    font-family: 'Gotham Medium', sans-serif; font-size: 10px; letter-spacing: 0.2em;
    text-transform: uppercase; color: #9A9A94;
  }
  #shopify-section-{{ section.id }} .sc-rev__track {
    display: flex; gap: 2px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
  }
  #shopify-section-{{ section.id }} .sc-rev__track::-webkit-scrollbar { height: 0; }
  #shopify-section-{{ section.id }} .sc-rev__card { flex: 0 0 260px; scroll-snap-align: start; }
  #shopify-section-{{ section.id }} .sc-rev__media {
    aspect-ratio: 1/1; position: relative;
    background: repeating-linear-gradient(120deg,#efefec 0 13px,#f6f6f4 13px 26px);
  }
  #shopify-section-{{ section.id }} .sc-rev__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .sc-rev__chip {
    position: absolute; bottom: 14px; left: 14px; z-index: 2; background: #fff; color: #1d1d1b;
    padding: 6px 10px; font-family: 'Gotham Medium', sans-serif; font-size: 8.5px; letter-spacing: 0.16em; text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .sc-rev__body { padding: 14px; }
  #shopify-section-{{ section.id }} .sc-rev__cstars { font-size: 12px; letter-spacing: 0.1em; margin-bottom: 10px; color: #000; }
  #shopify-section-{{ section.id }} .sc-rev__quote {
    font-family: 'Gotham Medium', sans-serif; font-size: 14px; line-height: 1.4; margin: 0 0 12px; color: #1d1d1b;
  }
  #shopify-section-{{ section.id }} .sc-rev__by {
    font-family: 'Gotham Medium', sans-serif; font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: #A8A8A2;
  }
  #shopify-section-{{ section.id }} .sc-rev__cta { text-align: center; margin-top: 26px; }
  #shopify-section-{{ section.id }} .sc-rev__btn {
    display: inline-block; border: 1px solid #1d1d1b; background: transparent; color: #1d1d1b;
    font-family: 'Gotham Medium', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; padding: 14px 34px; transition: all .18s;
  }
  #shopify-section-{{ section.id }} .sc-rev__btn:hover { background: #1d1d1b; color: #fff; }
  @media (min-width: 750px) { #shopify-section-{{ section.id }} .sc-rev__card { flex-basis: 300px; } }
</style>
<div class="sc-rev">
  <div class="sc-rev__head">
    <div class="sc-rev__score">{{ section.settings.score }}</div>
    <div class="sc-rev__stars">★★★★★</div>
    <div class="sc-rev__count">{{ section.settings.count_label }}</div>
  </div>
  <div class="sc-rev__track">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="sc-rev__card" {{ block.shopify_attributes }}>
          <div class="sc-rev__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '260px', widths: '260, 390, 520, 600', alt: block.settings.name | escape }}
            {%- endif -%}
            {%- if block.settings.product != blank -%}<span class="sc-rev__chip">Shop {{ block.settings.product }}</span>{%- endif -%}
          </div>
          <div class="sc-rev__body">
            <div class="sc-rev__cstars">★★★★★</div>
            <p class="sc-rev__quote">“{{ block.settings.quote }}”</p>
            <div class="sc-rev__by">{{ block.settings.name }} · Verified buyer</div>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- assign phr = 'My hair has never looked so polished.|Amara K.|Stick,The stick lives in my bag now.|Priya S.|Stick,Frizz gone in seconds, no crunch.|Jo M.|Cream,Feels like skincare for my hair.|Elle R.|Balm' | split: ',' -%}
      {%- for item in phr -%}
        {%- assign parts = item | split: '|' -%}
        <div class="sc-rev__card">
          <div class="sc-rev__media"><span class="sc-rev__chip">Shop {{ parts[2] }}</span></div>
          <div class="sc-rev__body">
            <div class="sc-rev__cstars">★★★★★</div>
            <p class="sc-rev__quote">“{{ parts[0] }}”</p>
            <div class="sc-rev__by">{{ parts[1] }} · Verified buyer</div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
  {%- if section.settings.button_label != blank -%}
    <div class="sc-rev__cta">
      <a class="sc-rev__btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "SC Reviews",
  "tag": "section",
  "class": "sc-section",
  "settings": [
    { "type": "paragraph", "content": "Provisional block — swap the cards for your reviews app (Loox / Klaviyo / Firework) once chosen. Score, count and CTA can stay." },
    { "type": "text", "id": "score", "label": "Aggregate score", "default": "4.7" },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "460+ verified reviews" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read all 460 reviews" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top spacing", "default": 72 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "My hair has never looked so polished." },
        { "type": "text", "id": "name", "label": "Name", "default": "Amara K." },
        { "type": "text", "id": "product", "label": "Product chip label", "default": "Stick" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SC Reviews",
      "blocks": [
        { "type": "review", "settings": { "quote": "My hair has never looked so polished.", "name": "Amara K.", "product": "Stick" } },
        { "type": "review", "settings": { "quote": "The stick lives in my bag now.", "name": "Priya S.", "product": "Stick" } },
        { "type": "review", "settings": { "quote": "Frizz gone in seconds, no crunch.", "name": "Jo M.", "product": "Cream" } },
        { "type": "review", "settings": { "quote": "Feels like skincare for my hair.", "name": "Elle R.", "product": "Balm" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
