{% comment %}
  SOAP. / The Smooth Company
  sc-bcorp-founder

  Founder quote. Image column and quote column are equal height on desktop:
  the image fills its side edge to edge, the quote sits centred beside it.
  Serif quote, small hanging mark, attribution locked beneath a short rule.
  Fresh id prefix f_ so nothing from earlier quote sections can map on.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign quote = s.f_quote | strip
  assign name = s.f_name | strip
  assign role = s.f_role | strip
  assign alt_photo = s.f_image.alt | default: name | default: 'Founder portrait'

  assign serif = s.f_font
  if serif == blank
    assign serif = 'var(--font-heading-family, var(--heading-font-family, Georgia, "Times New Roman", serif))'
  endif

  assign img_order = 1
  assign txt_order = 2
  if s.f_position == 'right'
    assign img_order = 2
    assign txt_order = 1
  endif
-%}

<style>
  /* Page scoped section gap reset */
  .wlm-content .shopify-section,
  #site-main .shopify-section { margin: 0 !important; padding: 0 !important; }
  wlm.wlm-content { display: contents; }
  #site-main .shopify-section > section { margin: 0 !important; }
  #site-main { gap: 0 !important; row-gap: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
  .wlm-content { gap: 0 !important; }

  #scf-{{ section.id }} {
    background-color: {{ s.f_bg }};
    color: {{ s.f_ink }};
  }

  #scf-{{ section.id }} .scf__inner {
    max-width: {{ s.f_max }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
  }

  /* Tailor hides content until its observer fires */
  #scf-{{ section.id }} .scf__inner,
  #scf-{{ section.id }} .scf__inner * {
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    animation: none !important;
    clip-path: none !important;
  }

  #scf-{{ section.id }} .scf__media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ s.f_ratio_m }};
    overflow: hidden;
    background-color: {{ s.f_placeholder }};
  }

  #scf-{{ section.id }} .scf__media img,
  #scf-{{ section.id }} .scf__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ s.f_focal }};
  }

  #scf-{{ section.id }} .scf__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: {{ s.f_pad_block_m }}px 24px;
  }

  #scf-{{ section.id }} .scf__quote {
    position: relative;
    margin: 0;
    padding: 0;
    font-family: {{ serif }};
    font-size: {{ s.f_size_m }}px;
    line-height: 1.36;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  #scf-{{ section.id }} .scf__quote::before {
    content: {% if s.f_show_mark %}'\201C'{% else %}''{% endif %};
    position: absolute;
    left: -0.05em;
    top: -0.62em;
    font-family: {{ serif }};
    font-size: 1.9em;
    line-height: 1;
    color: {{ s.f_mark_color }};
    pointer-events: none;
  }

  #scf-{{ section.id }} .scf__attr {
    margin-top: {{ s.f_gap_attr }}px;
    padding-top: {{ s.f_gap_attr }}px;
    border-top: 1px solid currentColor;
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    align-self: flex-start;
  }

  #scf-{{ section.id }} .scf__name {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  #scf-{{ section.id }} .scf__role {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  @media screen and (min-width: 900px) {
    #scf-{{ section.id }} .scf__inner {
      grid-template-columns: {{ s.f_media_w }}fr {{ 100 | minus: s.f_media_w }}fr;
      align-items: stretch;
    }
    #scf-{{ section.id }} .scf__media {
      aspect-ratio: auto;
      height: 100%;
      min-height: {{ s.f_min_h }}px;
      order: {{ img_order }};
    }
    #scf-{{ section.id }} .scf__content {
      order: {{ txt_order }};
      padding: {{ s.f_pad_block_d }}px {{ s.f_pad_inline_d }}px;
    }
    #scf-{{ section.id }} .scf__quote {
      font-size: {{ s.f_size_d }}px;
    }
  }
</style>

<section id="scf-{{ section.id }}" class="scf" {{ section.shopify_attributes }}>
  <div class="scf__inner">
    <div class="scf__media">
      {%- if s.f_image != blank -%}
        {{
          s.f_image
          | image_url: width: 1400
          | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 45vw, 100vw', widths: '480, 768, 1000, 1400', alt: alt_photo
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    <div class="scf__content">
      {%- if quote != blank -%}
        <blockquote class="scf__quote">{{ quote }}</blockquote>
      {%- endif -%}

      {%- if name != blank -%}
        <div class="scf__attr">
          <span class="scf__name">{{ name }}</span>
          {%- if role != blank -%}
            <span class="scf__role">{{ role }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "B Corp: Founder",
  "tag": "section",
  "class": "scf-section",
  "settings": [
    {
      "type": "textarea",
      "id": "f_quote",
      "label": "Quote",
      "info": "No quotation marks. Use the quote mark toggle below.",
      "default": "The Smooth Company was never just about creating products people love. It was about building a business that could make a positive impact."
    },
    {
      "type": "text",
      "id": "f_name",
      "label": "Name",
      "default": "Áine Kennedy"
    },
    {
      "type": "text",
      "id": "f_role",
      "label": "Role",
      "default": "Founder and CEO"
    },
    {
      "type": "checkbox",
      "id": "f_show_mark",
      "label": "Show opening quote mark",
      "default": true
    },
    {
      "type": "text",
      "id": "f_font",
      "label": "Quote font family",
      "info": "Optional. Empty uses the theme heading serif. Or paste the Typekit family name (kit ffy5vbd)."
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "f_image",
      "label": "Photo"
    },
    {
      "type": "select",
      "id": "f_position",
      "label": "Photo position, desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "f_focal",
      "label": "Photo focal point",
      "options": [
        { "value": "left center", "label": "Left" },
        { "value": "center center", "label": "Centre" },
        { "value": "right center", "label": "Right" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "f_ratio_m",
      "label": "Photo ratio, mobile",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "4 / 3", "label": "Landscape 4:3" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "color",
      "id": "f_placeholder",
      "label": "Placeholder colour",
      "default": "#b5e3d9"
    },
    {
      "type": "header",
      "content": "Layout, desktop"
    },
    {
      "type": "range",
      "id": "f_media_w",
      "label": "Photo column width",
      "min": 35,
      "max": 55,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "range",
      "id": "f_min_h",
      "label": "Minimum row height",
      "min": 320,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "f_pad_inline_d",
      "label": "Quote side padding",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "f_pad_block_d",
      "label": "Quote top and bottom padding",
      "min": 24,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Layout, mobile"
    },
    {
      "type": "range",
      "id": "f_pad_block_m",
      "label": "Quote top and bottom padding",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "f_gap_attr",
      "label": "Space around attribution rule",
      "min": 12,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "f_max",
      "label": "Section max width",
      "min": 900,
      "max": 1500,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Colour and type"
    },
    {
      "type": "color",
      "id": "f_bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "f_ink",
      "label": "Text",
      "default": "#1d1d1b"
    },
    {
      "type": "color",
      "id": "f_mark_color",
      "label": "Quote mark colour",
      "default": "#b5e3d9"
    },
    {
      "type": "range",
      "id": "f_size_d",
      "label": "Quote size, desktop",
      "min": 20,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 27
    },
    {
      "type": "range",
      "id": "f_size_m",
      "label": "Quote size, mobile",
      "min": 16,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 21
    }
  ],
  "presets": [
    {
      "name": "B Corp: Founder"
    }
  ]
}
{% endschema %}
