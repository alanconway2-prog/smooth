    endif
    assign new_color = new_color | color_lighten: light_adjustment
  endif
-%}
{{- new_color -}}
{%- liquid
  assign morph_base_color = blank
  assign morph_adjustment = blank
-%}

{% comment %}Inject morph end{% endcomment %}{% endcapture %}

    {% style %}
      :root {
        --color-heading: {{ settings.color_heading }};
        --color-body: {{ color_body }};
        --color-accent: {{ color_accent }};
        --color-link: {{ color_accent }};
        --color-body-rgb: {{ color_body_rgb }};
        --color-accent-rgb: {{ color_accent_rgb }};
        --color-link-rgb: {{ color_accent_rgb }};
        --color-accent-morphed: {{ color_accent_morphed }};
        --color-link-hover: {{ color_accent_morphed }};
        --color-site-background: {{ color_site_background }};
        --color-site-background-secondary: {{ settings.color_site_background_secondary }};
        --color-lines-and-borders: {{ color_lines | color_modify: 'alpha', 0.15 }};
        --color-lines-and-borders-darker: {{ color_lines | color_modify: 'alpha', 0.35 }};
        --color-sale: {{ color_sale }};
        --color-sale-badge-label: {{ settings.color_badge_text }};
        --color-sale-badge-background: {{ settings.color_badge_background }};
        --color-price-regular: {{ color_body }};
        --color-price-sale: {{ color_sale }};
        --color-price-savings: {{ color_sale }};
        --color-price-compare: {{ color_body_alpha_60 }};
        --color-placeholder: {{ color_body | color_modify: 'alpha', 0.1 }};
        --color-star-ratings-active: {{ settings.color_star_ratings }};
        --color-star-ratings-inactive: {{ color_body_alpha_60 }};
        --color-in-stock: {{ settings.color_in_stock }};
        --color-low-in-stock: {{ settings.color_low_in_stock }};
        --color-out-of-stock: {{ settings.color_out_of_stock }};
        --color-vendor: {{ color_body | color_modify: 'alpha', 0.75 }};
        --color-button-main: {{ color_button_main }};
