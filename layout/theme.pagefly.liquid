        --color-button-main-contrast: {{ settings.color_button_main_contrast }};
        --color-button-quiet: {{ color_accent }};
        --color-button-quiet-invoked: {{ color_accent_morphed }};
        --color-button-signpost: {{ color_accent }};
        --color-button-signpost-invoked: {{ color_accent_morphed }};
        --color-fab-foreground: {{ color_body }};
        --color-fab-background: {{ color_site_background }};
        --color-fab-quiet: {{ color_body }};
        --color-form-foreground: {{ color_body }};
